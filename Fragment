                        <h2>Lisa</h2>

                        <p>
                            Your virtual customer care assistant
                        </p>
                    </div>

                    <div
                        id="listeningIndicator"
                        class="activity-indicator"
                        hidden
                    >
                        <span class="pulse-dot"></span>
                        Listening
                    </div>

                    <div
                        id="speakingIndicator"
                        class="activity-indicator"
                        hidden
                    >
                        <span class="wave-bars">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>

                        Speaking
                    </div>

                </div>


                <div class="call-information">

                    <div class="agent-information">
                        <h2>Lisa</h2>
                        <p>DU Customer Care Assistant</p>
