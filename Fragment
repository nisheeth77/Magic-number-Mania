
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --primary: #00a9ce;
    --primary-dark: #0088a8;
    --danger: #e5484d;
    --danger-dark: #c9363b;
    --background: #f3f6f9;
    --surface: #ffffff;
    --text: #17212b;
    --muted: #687481;
    --border: #dde4ea;
    --success: #22a06b;
    --warning: #e2a100;
    --shadow: 0 14px 40px rgba(25, 45, 65, 0.12);
}

html,
body {
    width: 100%;
    min-height: 100%;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
}

button {
    font: inherit;
}

.app-shell {
    width: 100%;
    min-height: 100vh;
}

/* Header */

.top-bar {
    min-height: 84px;
    padding: 18px 32px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.brand-section {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-logo {
    width: 52px;
    height: 52px;
    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--primary);
    color: #ffffff;
    font-size: 23px;
    font-weight: 700;
    text-transform: lowercase;
}

.brand-section h1 {
    font-size: 22px;
    margin-bottom: 4px;
}

.brand-section p {
    color: var(--muted);
    font-size: 14px;
}

.connection-status {
    display: flex;
    align-items: center;
    gap: 9px;

    padding: 10px 14px;
    border-radius: 999px;
    background: #f7f9fb;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #98a2ad;
}

.status-dot.connected {
    background: var(--success);
    box-shadow: 0 0 0 5px rgba(34, 160, 107, 0.15);
}

.status-dot.connecting,
.status-dot.listening {
    background: var(--warning);
    box-shadow: 0 0 0 5px rgba(226, 161, 0, 0.15);
}

.status-dot.speaking {
    background: var(--primary);
    box-shadow: 0 0 0 5px rgba(0, 169, 206, 0.16);
}

.status-dot.error {
    background: var(--danger);
    box-shadow: 0 0 0 5px rgba(229, 72, 77, 0.15);
}

.status-dot.disconnected {
    background: #98a2ad;
}

/* Main layout */

.main-content {
    width: min(1440px, calc(100% - 48px));
    margin: 24px auto;

    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.8fr);
    gap: 24px;
}

/* Avatar card */

.avatar-panel,
.transcript-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
    overflow: hidden;
}

.avatar-panel {
    padding: 20px;
}

.video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;

    overflow: hidden;
    border-radius: 16px;
    background:
        radial-gradient(circle at top, #eaf9fc, #dbe6ee);
}

#avatarVideo {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;
    object-fit: contain;
    background: #101820;
}

.avatar-placeholder {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 30px;
    text-align: center;
}

.avatar-placeholder[hidden] {
    display: none;
}

.avatar-placeholder-icon {
    width: 104px;
    height: 104px;
    margin-bottom: 18px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(255, 255, 255, 0.9);
    font-size: 56px;
    box-shadow: 0 12px 30px rgba(37, 75, 100, 0.15);
}

.avatar-placeholder h2 {
    font-size: 28px;
    margin-bottom: 8px;
}

.avatar-placeholder p {
    color: var(--muted);
    font-size: 15px;
}

.activity-indicator {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 4;

    display: flex;
    align-items: center;
    gap: 9px;

    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(16, 24, 32, 0.82);
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    backdrop-filter: blur(8px);
}

.activity-indicator[hidden] {
    display: none;
}

.pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffffff;
    animation: pulse 1s infinite;
}

.wave-bars {
    height: 18px;
    display: flex;
    align-items: center;
    gap: 3px;
}

.wave-bars span {
    width: 3px;
    height: 8px;
    border-radius: 4px;
    background: #ffffff;
    animation: wave 0.8s infinite ease-in-out;
}

.wave-bars span:nth-child(2) {
    animation-delay: 0.1s;
}

.wave-bars span:nth-child(3) {
    animation-delay: 0.2s;
}

.wave-bars span:nth-child(4) {
    animation-delay: 0.3s;
}

.call-information {
    padding: 18px 4px 10px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.agent-information h2 {
    font-size: 21px;
    margin-bottom: 4px;
}

.agent-information p {
    color: var(--muted);
    font-size: 14px;
}

.call-timer {
    min-width: 78px;
    padding: 9px 12px;
    border-radius: 10px;

    background: #f2f5f7;
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

/* Controls */

.call-controls {
    padding-top: 14px;

    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
}

.control-button {
    min-width: 132px;
    min-height: 48px;
    padding: 12px 18px;

    border: none;
    border-radius: 12px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    cursor: pointer;
    font-weight: 700;
    transition:
        transform 0.2s ease,
        background 0.2s ease,
        opacity 0.2s ease;
}

.control-button:hover:not(:disabled) {
    transform: translateY(-2px);
}

.control-button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
}

.start-button {
    background: var(--primary);
    color: #ffffff;
}

.start-button:hover:not(:disabled) {
    background: var(--primary-dark);
}

.secondary-button {
    background: #e9eef2;
    color: var(--text);
}

.secondary-button.muted {
    background: #fff1f2;
    color: var(--danger);
}

.end-button {
    background: var(--danger);
    color: #ffffff;
}

.end-button:hover:not(:disabled) {
    background: var(--danger-dark);
}

.button-icon {
    font-size: 18px;
}

/* Transcript */

.transcript-panel {
    min-height: 600px;

    display: flex;
    flex-direction: column;
}

.transcript-header {
    padding: 20px;
    border-bottom: 1px solid var(--border);

    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
}

.transcript-header h2 {
    font-size: 19px;
    margin-bottom: 5px;
}

.transcript-header p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
}

.live-badge {
    padding: 6px 9px;
    border-radius: 999px;

    background: #e9f8f2;
    color: var(--success);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.7px;
}

.transcript-container {
    flex: 1;
    min-height: 430px;
    max-height: 570px;
    padding: 18px;

    overflow-y: auto;
    background: #fafbfd;
}

.transcript-welcome {
    min-height: 360px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 28px;
    text-align: center;
    color: var(--muted);
}

.welcome-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 16px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #e9f7fb;
    font-size: 31px;
}

.transcript-welcome h3 {
    margin-bottom: 8px;
    color: var(--text);
    font-size: 18px;
}

.transcript-welcome p {
    max-width: 320px;
    font-size: 14px;
    line-height: 1.6;
}

.transcript-message {
    width: fit-content;
    max-width: 88%;
    margin-bottom: 14px;
    padding: 12px 14px;
    border-radius: 14px;
}

.user-message {
    margin-left: auto;
    background: var(--primary);
    color: #ffffff;
    border-bottom-right-radius: 4px;
}

.agent-message {
    margin-right: auto;
    background: #edf1f4;
    color: var(--text);
    border-bottom-left-radius: 4px;
}

.transcript-speaker {
    margin-bottom: 5px;
    font-size: 11px;
    font-weight: 800;
    opacity: 0.8;
    text-transform: uppercase;
}

.transcript-text {
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-wrap;
}

.privacy-notice {
    padding: 14px 18px;
    border-top: 1px solid var(--border);

    display: flex;
    align-items: center;
    gap: 9px;

    color: var(--muted);
    font-size: 12px;
}

.privacy-icon {
    flex-shrink: 0;
}

/* Animations */

@keyframes pulse {
    0%,
    100% {
        opacity: 0.45;
        transform: scale(0.85);
    }

    50% {
        opacity: 1;
        transform: scale(1.2);
    }
}

@keyframes wave {
    0%,
    100% {
        height: 6px;
    }

    50% {
        height: 18px;
    }
}

/* Responsive */

@media (max-width: 960px) {
    .main-content {
        grid-template-columns: 1fr;
    }

    .transcript-panel {
        min-height: 500px;
    }
}

@media (max-width: 640px) {
    .top-bar {
        padding: 16px;
        align-items: flex-start;
        flex-direction: column;
    }

    .main-content {
        width: calc(100% - 24px);
        margin: 12px auto;
        gap: 14px;
    }

    .avatar-panel {
        padding: 12px;
    }

    .call-controls {
        flex-wrap: wrap;
    }

    .control-button {
        min-width: 110px;
        flex: 1;
    }

    .brand-section p {
        display: none;
    }

    .video-wrapper {
        aspect-ratio: 4 / 3;
    }
}






<fragment>

    <!-- ========================================================= -->
    <!-- Capture the backend response without consuming the body   -->
    <!-- ========================================================= -->

    <set-variable name="responseBody" value="@{
        var body =
            context.Response.Body?.As<string>(
                preserveContent: true
            ) ?? string.Empty;

        return body.Length > 8000
            ? body.Substring(0, 8000) + "...[TRUNCATED]"
            : body;
    }" />


    <!-- ========================================================= -->
    <!-- Calculate total request latency                           -->
    <!-- ========================================================= -->

    <set-variable name="latencyMs" value="@{
        var startTime =
            context.Variables.GetValueOrDefault<long>(
                "startTime",
                DateTime.UtcNow.Ticks
            );

        return (DateTime.UtcNow.Ticks - startTime)
            / TimeSpan.TicksPerMillisecond;
    }" />


    <!-- ========================================================= -->
    <!-- Extract prompt/input tokens                               -->
    <!-- Supports Chat Completions and Responses API formats       -->
    <!-- ========================================================= -->

    <set-variable name="promptTokens" value="@{
        try
        {
            var responseBody =
                context.Variables.GetValueOrDefault<string>(
                    "responseBody",
                    string.Empty
                );

            if (string.IsNullOrWhiteSpace(responseBody))
            {
                return 0;
            }

            var responseJson = JObject.Parse(responseBody);
            var usage = responseJson["usage"];

            if (usage == null)
            {
                return 0;
            }

            return
                (int?)usage["prompt_tokens"]
                ?? (int?)usage["input_tokens"]
                ?? 0;
        }
        catch
        {
            return 0;
        }
    }" />


    <!-- ========================================================= -->
    <!-- Extract completion/output tokens                          -->
    <!-- ========================================================= -->

    <set-variable name="completionTokens" value="@{
        try
        {
            var responseBody =
                context.Variables.GetValueOrDefault<string>(
                    "responseBody",
                    string.Empty
                );

            if (string.IsNullOrWhiteSpace(responseBody))
            {
                return 0;
            }

            var responseJson = JObject.Parse(responseBody);
            var usage = responseJson["usage"];

            if (usage == null)
            {
                return 0;
            }

            return
                (int?)usage["completion_tokens"]
                ?? (int?)usage["output_tokens"]
                ?? 0;
        }
        catch
        {
            return 0;
        }
    }" />


    <!-- ========================================================= -->
    <!-- Extract total tokens                                      -->
    <!-- Falls back to prompt + completion when total is absent     -->
    <!-- ========================================================= -->

    <set-variable name="totalTokens" value="@{
        try
        {
            var promptTokens =
                context.Variables.GetValueOrDefault<int>(
                    "promptTokens",
                    0
                );

            var completionTokens =
                context.Variables.GetValueOrDefault<int>(
                    "completionTokens",
                    0
                );

            var responseBody =
                context.Variables.GetValueOrDefault<string>(
                    "responseBody",
                    string.Empty
                );

            if (string.IsNullOrWhiteSpace(responseBody))
            {
                return promptTokens + completionTokens;
            }

            var responseJson = JObject.Parse(responseBody);
            var usage = responseJson["usage"];

            if (usage == null)
            {
                return promptTokens + completionTokens;
            }

            return
                (int?)usage["total_tokens"]
                ?? promptTokens + completionTokens;
        }
        catch
        {
            return
                context.Variables.GetValueOrDefault<int>(
                    "promptTokens",
                    0
                )
                +
                context.Variables.GetValueOrDefault<int>(
                    "completionTokens",
                    0
                );
        }
    }" />


    <!-- ========================================================= -->
    <!-- Mask basic PII patterns inside the prompt                 -->
    <!-- ========================================================= -->

    <set-variable name="promptMasked" value="@{
        var prompt =
            context.Variables.GetValueOrDefault<string>(
                "promptBody",
                string.Empty
            );

        /*
         * Email address
         */
        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @&quot;\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b&quot;,
            "[EMAIL]"
        );

        /*
         * US-style SSN
         */
        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @&quot;\b\d{3}-\d{2}-\d{4}\b&quot;,
            "[SSN]"
        );

        /*
         * Possible payment-card number
         */
        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @&quot;\b(?:\d[ \-]*?){13,16}\b&quot;,
            "[CARD]"
        );

        /*
         * Possible phone number
         */
        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @&quot;\+?\d[\d\s\-()]{8,14}\d&quot;,
            "[PHONE]"
        );

        return prompt;
    }" />


    <!-- ========================================================= -->
    <!-- Determine whether basic PII masking changed the prompt     -->
    <!-- ========================================================= -->

    <set-variable name="piiDetected" value="@{
        var originalPrompt =
            context.Variables.GetValueOrDefault<string>(
                "promptBody",
                string.Empty
            );

        var maskedPrompt =
            context.Variables.GetValueOrDefault<string>(
                "promptMasked",
                string.Empty
            );

        return !string.Equals(
            originalPrompt,
            maskedPrompt,
            StringComparison.Ordinal
        );
    }" />


    <!-- ========================================================= -->
    <!-- Send the complete structured record to Event Hub          -->
    <!-- ========================================================= -->

    <log-to-eventhub
        logger-id="YOUR-EVENT-HUB-LOGGER-ID">
        @{
            var payload = new JObject
            {
                /*
                 * Request and conversation identifiers
                 */
                ["CorrelationId"] =
                    context.Variables.GetValueOrDefault<string>(
                        "correlationId",
                        context.RequestId.ToString()
                    ),

                ["RequestTimestamp"] =
                    context.Variables.GetValueOrDefault<string>(
                        "requestTimestamp",
                        DateTime.UtcNow.ToString("o")
                    ),

                ["SessionId"] =
                    context.Variables.GetValueOrDefault<string>(
                        "sessionId",
                        "no-session"
                    ),


                /*
                 * User and organisational attribution
                 */
                ["UserId"] =
                    context.Variables.GetValueOrDefault<string>(
                        "userId",
                        "anonymous"
                    ),

                ["TeamId"] =
                    context.Variables.GetValueOrDefault<string>(
                        "teamId",
                        "unassigned"
                    ),

                ["BusinessUnit"] =
                    context.Variables.GetValueOrDefault<string>(
                        "businessUnit",
                        "unassigned"
                    ),

                ["CostCenter"] =
                    context.Variables.GetValueOrDefault<string>(
                        "costCenter",
                        "unassigned"
                    ),

                ["AgentId"] =
                    context.Variables.GetValueOrDefault<string>(
                        "agentId",
                        "direct-call"
                    ),


                /*
                 * API information
                 */
                ["ApiName"] =
                    context.Api != null
                        ? context.Api.Name
                        : "unknown-api",

                ["OperationName"] =
                    context.Operation != null
                        ? context.Operation.Name
                        : "unknown-operation",


                /*
                 * Model-routing information
                 */
                ["ModelProvider"] =
                    context.Variables.GetValueOrDefault<string>(
                        "modelProvider",
                        "unknown"
                    ),

                ["ModelName"] =
                    context.Variables.GetValueOrDefault<string>(
                        "modelName",
                        "unknown"
                    ),

                ["ModelDeployment"] =
                    context.Variables.GetValueOrDefault<string>(
                        "modelDeployment",
                        "unknown"
                    ),

                ["RegionRouted"] =
                    context.Variables.GetValueOrDefault<string>(
                        "regionRouted",
                        context.Deployment.Region
                    ),


                /*
                 * Prompt and response
                 */
                ["PromptText"] =
                    context.Variables.GetValueOrDefault<string>(
                        "promptMasked",
                        string.Empty
                    ),

                ["ResponseText"] =
                    context.Variables.GetValueOrDefault<string>(
                        "responseBody",
                        string.Empty
                    ),


                /*
                 * Token usage
                 */
                ["PromptTokens"] =
                    context.Variables.GetValueOrDefault<int>(
                        "promptTokens",
                        0
                    ),

                ["CompletionTokens"] =
                    context.Variables.GetValueOrDefault<int>(
                        "completionTokens",
                        0
                    ),

                ["TotalTokens"] =
                    context.Variables.GetValueOrDefault<int>(
                        "totalTokens",
                        0
                    ),


                /*
                 * Performance and status
                 */
                ["LatencyMs"] =
                    context.Variables.GetValueOrDefault<long>(
                        "latencyMs",
                        0
                    ),

                ["HttpStatus"] =
                    context.Response != null
                        ? context.Response.StatusCode
                        : 0,


                /*
                 * Governance flags
                 */
                ["ContentSafetyFlag"] =
                    context.Variables.GetValueOrDefault<bool>(
                        "contentSafetyTriggered",
                        false
                    ),

                ["PIIDetected"] =
                    context.Variables.GetValueOrDefault<bool>(
                        "piiDetected",
                        false
                    ),


                /*
                 * APIM subscription and product
                 */
                ["SubscriptionId"] =
                    context.Subscription != null
                        ? context.Subscription.Id
                        : "no-subscription",

                ["ProductName"] =
                    context.Product != null
                        ? context.Product.Name
                        : "no-product"
            };

            return payload.ToString(
                Newtonsoft.Json.Formatting.None
            );
        }
    </log-to-eventhub>


    <!-- ========================================================= -->
    <!-- Temporary verification trace                              -->
    <!-- Remove after Event Hub logging is confirmed               -->
    <!-- ========================================================= -->

    <trace
        source="AI-Gateway-EventHub-Logger"
        severity="information">

        <message>
            AI Gateway event sent to Event Hub
        </message>

        <metadata
            name="CorrelationId"
            value="@(
                context.Variables.GetValueOrDefault<string>(
                    "correlationId",
                    "missing"
                )
            )" />

        <metadata
            name="SessionId"
            value="@(
                context.Variables.GetValueOrDefault<string>(
                    "sessionId",
                    "missing"
                )
            )" />

        <metadata
            name="PromptTokens"
            value="@(
                context.Variables.GetValueOrDefault<int>(
                    "promptTokens",
                    0
                ).ToString()
            )" />

        <metadata
            name="CompletionTokens"
            value="@(
                context.Variables.GetValueOrDefault<int>(
                    "completionTokens",
                    0
                ).ToString()
            )" />

        <metadata
            name="TotalTokens"
            value="@(
                context.Variables.GetValueOrDefault<int>(
                    "totalTokens",
                    0
                ).ToString()
            )" />

        <metadata
            name="LatencyMs"
            value="@(
                context.Variables.GetValueOrDefault<long>(
                    "latencyMs",
                    0
                ).ToString()
            )" />

        <metadata
            name="HttpStatus"
            value="@(
                context.Response.StatusCode.ToString()
            )" />

    </trace>

</fragment>







