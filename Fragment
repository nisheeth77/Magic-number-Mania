        "avatar": {
            "character": "lisa",
            "style": "casual-sitting",
        },
    }


# ============================================================
# Utility functions
# ============================================================

async def send_browser_event(
    browser_ws: WebSocket,
    event_type: str,
    **values: Any,
) -> None:
    await browser_ws.send_json(
        {
            "type": event_type,
            **values,
        }
    )


def serialize_sdk_event(event: Any) -> dict[str, Any]:
    """
    Convert a typed Voice Live SDK server event to a plain dictionary.
    """

    if isinstance(event, dict):
        return event

    if hasattr(event, "as_dict"):
        value = event.as_dict()

        if isinstance(value, dict):
            return value

    if hasattr(event, "model_dump"):
        value = event.model_dump(
            mode="json",
            exclude_none=True,
        )

        if isinstance(value, dict):
            return value

    if hasattr(event, "__dict__"):
        return {
            key: value
            for key, value in vars(event).items()
            if not key.startswith("_")
        }

    return {
        "type": "unknown",
        "value": str(event),
    }


# ============================================================
# Browser -> Voice Live
# ============================================================

async def browser_to_voice_live(
    browser_ws: WebSocket,
    voice_connection: Any,
) -> None:
    """
    Forward browser events and microphone audio to Voice Live.

    Text messages:
        JSON Voice Live client events.

    Binary messages:
        Raw PCM16 microphone audio. The backend converts the
        audio to Base64 and appends it to the Voice Live input buffer.
    """

    while True:
        browser_message = await browser_ws.receive()

        websocket_message_type = browser_message.get("type")

        if websocket_message_type == "websocket.disconnect":
            raise WebSocketDisconnect()

        text_data = browser_message.get("text")
        binary_data = browser_message.get("bytes")

        if text_data is not None:
            try:
                event = json.loads(text_data)
            except json.JSONDecodeError:
                await send_browser_event(
                    browser_ws,
                    "application.error",
                    message="The browser sent invalid JSON.",
                )
                continue

            event_type = event.get("type", "unknown")

            # These are application-only messages and must not
            # be forwarded to Azure.
            if event_type == "application.ping":
                await send_browser_event(
                    browser_ws,
                    "application.pong",
                )
                continue

            if event_type == "application.disconnect":
                return

            logger.debug(
                "Browser -> Voice Live: %s",
                event_type,
            )

            # The SDK accepts dictionaries and serializes them
            # as Voice Live client events.
            await voice_connection.send(event)

        elif binary_data is not None:
            if not binary_data:
                continue

            audio_base64 = base64.b64encode(
                binary_data
            ).decode("ascii")

            await voice_connection.input_audio_buffer.append(
                audio=audio_base64
            )


# ============================================================
# Voice Live -> Browser
# ============================================================

async def voice_live_to_browser(
    voice_connection: Any,
    browser_ws: WebSocket,
) -> None:
    """
    Receive typed Voice Live server events and send them to app.js.

    This includes:
    - session events
    - user transcription
    - assistant transcription
    - assistant audio deltas
    - speech-start/speech-stop events
    - avatar negotiation events
    - errors and warnings
    """

    while True:
        sdk_event = await voice_connection.recv()

        if sdk_event is None:
            logger.info(
                "Voice Live returned no further events"
            )
            return

        event = serialize_sdk_event(sdk_event)
        event_type = event.get("type", "unknown")

        logger.debug(
            "Voice Live -> Browser: %s",
            event_type,
        )

        await browser_ws.send_text(
            json.dumps(
                event,
                default=str,
            )
        )


# ============================================================
# Main Voice Live WebSocket
# ============================================================

@app.websocket("/ws/voice")
async def voice_websocket(
    browser_ws: WebSocket,
):
    await browser_ws.accept()

    logger.info("Browser connected to /ws/voice")

    await send_browser_event(
        browser_ws,
        "application.connecting",
        message="Connecting to Azure Voice Live...",
    )

    credential: AzureCliCredential = (
        browser_ws.app.state.azure_credential
    )

    connect_arguments: dict[str, Any] = {
        "endpoint": VOICE_LIVE_ENDPOINT,
        "credential": credential,
        "api_version": VOICE_LIVE_API_VERSION,
        "project_name": PROJECT_NAME,
        "agent_name": AGENT_NAME,
    }

    if AGENT_VERSION:
        connect_arguments["agent_version"] = AGENT_VERSION

    if CONVERSATION_ID:
        connect_arguments["conversation_id"] = (
            CONVERSATION_ID
        )

    try:
        # The SDK constructs the correct:
        # /voice-live/realtime endpoint,
        # authentication headers,
        # agent-name/project-name/version parameters.
        async with connect(
            **connect_arguments
        ) as voice_connection:

            logger.info(
                "Connected to Voice Live agent %s",
                AGENT_NAME,
            )

            await send_browser_event(
                browser_ws,
                "application.connected",
                message="Connected to Azure Voice Live.",
                agent={
                    "name": AGENT_NAME,
                    "version": (
                        AGENT_VERSION or "latest"
                    ),
                    "project": PROJECT_NAME,
                },
            )

            browser_task = asyncio.create_task(
                browser_to_voice_live(
                    browser_ws,
                    voice_connection,
                ),
                name="browser-to-voice-live",
            )

            azure_task = asyncio.create_task(
                voice_live_to_browser(
                    voice_connection,
                    browser_ws,
                ),
                name="voice-live-to-browser",
            )

            done, pending = await asyncio.wait(
                {
                    browser_task,
                    azure_task,
                },
                return_when=asyncio.FIRST_COMPLETED,
            )

            for task in pending:
                task.cancel()

            if pending:
                await asyncio.gather(
                    *pending,
                    return_exceptions=True,
                )

            for task in done:
                if task.cancelled():
                    continue

                exception = task.exception()

                if exception is not None:
                    raise exception

    except WebSocketDisconnect:
        logger.info("Browser disconnected")

    except asyncio.CancelledError:
        logger.info("Voice session cancelled")
        raise

    except Exception as exc:
        logger.exception(
            "Voice Live session failed"
        )

        with suppress(Exception):
            await send_browser_event(
                browser_ws,
                "application.error",
                message=str(exc),
            )

    finally:
        with suppress(Exception):
            await browser_ws.close()

        logger.info("Voice Live browser session closed")


