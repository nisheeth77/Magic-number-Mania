<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DU Virtual Assistant</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', path='style.css') }}"
    >
</head>

<body>

<div class="application-shell">

    <!-- Header -->
    <header class="top-header">

        <div class="brand">

            <div class="brand-logo">
                du
            </div>

            <div class="brand-text">
                <h1>Customer Support</h1>
                <p>AI-powered voice assistance</p>
            </div>

        </div>

        <div class="header-status">

            <span
                id="statusDot"
                class="status-dot disconnected"
            ></span>

            <span id="connectionStatus">
                Disconnected
            </span>

        </div>

    </header>


    <!-- Main workspace -->
    <main class="workspace">

        <!-- Conversation panel -->
        <section class="conversation-panel">

            <div class="panel-heading">

                <div>
                    <p class="eyebrow">
                        LIVE CONVERSATION
                    </p>

                    <h2>
                        How can we help you?
                    </h2>
                </div>

                <div
                    id="callDuration"
                    class="call-duration"
                >
                    00:00
                </div>

            </div>


            <div
                id="transcriptContainer"
                class="transcript-container"
                aria-live="polite"
            >

                <div class="welcome-card">

                    <div class="welcome-icon">
                        ✦
                    </div>

                    <div>
                        <h3>Hello! I’m Lisa</h3>

                        <p>
                            Start the call and speak naturally.
                            I can assist you in English, Hindi,
                            Arabic and Urdu.
                        </p>
                    </div>

                </div>

            </div>


            <!-- Current transcription -->
            <div class="live-transcription">

                <div class="transcription-row">

                    <span class="speaker-label user-label">
                        You
                    </span>

                    <p id="userTranscript">
                        Your speech will appear here.
                    </p>

                </div>

                <div class="transcription-row">

                    <span class="speaker-label assistant-label">
                        Lisa
                    </span>

                    <p id="agentTranscript">
                        Lisa's response will appear here.
                    </p>

                </div>

            </div>


            <!-- Call controls -->
            <div class="call-controls">

                <button
                    id="callButton"
                    class="call-button start"
                    type="button"
                >

                    <span
                        id="callButtonIcon"
                        class="call-button-icon"
                    >
                        🎙
                    </span>

                    <span id="callButtonText">
                        Start Call
                    </span>

                </button>

                <p
                    id="message"
                    class="call-message"
                    role="status"
                >
                    Click Start Call to connect with Lisa.
                </p>

            </div>

        </section>


        <!-- Avatar panel -->
        <section class="assistant-panel">

            <div class="assistant-background-circle"></div>

            <div class="avatar-card">

                <div class="avatar-heading">

                    <div>
                        <p class="eyebrow">
                            VIRTUAL ASSISTANT
                        </p>

                        <h2>Lisa</h2>
                    </div>

                    <span
                        id="assistantState"
                        class="assistant-state"
                    >
                        Offline
                    </span>

                </div>


                <div class="avatar-video-container">

                    <!-- Azure sends Lisa's synchronized
                         video and audio through WebRTC. -->
                    <video
                        id="avatarVideo"
                        autoplay
                        playsinline
                    ></video>


                    <!-- Fallback displayed before WebRTC connects -->
                    <div
                        id="avatarPlaceholder"
                        class="avatar-placeholder"
                    >

                        <div class="placeholder-avatar">

                            <div class="placeholder-head">
                                <div class="placeholder-hair"></div>
                                <div class="placeholder-face"></div>
                            </div>

                            <div class="placeholder-body"></div>

                        </div>

                        <div
                            id="avatarLoading"
                            class="avatar-loading"
                        >
                            <span class="loading-dot"></span>
                            <span class="loading-dot"></span>
                            <span class="loading-dot"></span>
                        </div>

                        <p id="avatarStatusText">
                            Lisa is ready when you are
                        </p>

                    </div>


                    <div
                        id="speakingIndicator"
                        class="speaking-indicator"
                    >
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                </div>


                <div class="assistant-features">

                    <span>Real-time</span>
                    <span>Multilingual</span>
                    <span>Secure</span>

                </div>

            </div>

        </section>

    </main>


    <footer class="footer">

        <p>
            Your microphone is used only during the active call.
        </p>

        <p>
            Powered by Azure AI Foundry Voice Live
        </p>

    </footer>

</div>


<!--
    Temporary local-development configuration.

    We will read these values from app.js.
    Do not expose a permanent Azure API key this way
    when deploying the application publicly.
-->
<script id="voiceLiveConfig" type="application/json">
{
    "endpoint": {{ voice_live_endpoint | tojson }},
    "apiKey": {{ api_key | tojson }},
    "model": {{ model | tojson }},
    "apiVersion": {{ api_version | tojson }},
    "avatarCharacter": "lisa",
    "avatarStyle": "casual-sitting"
}
</script>

<script
    src="{{ url_for('static', path='app.js') }}"
    defer
></script>

</body>
</html>





"use strict";

const configElement = document.getElementById("voiceLiveConfig");

let voiceLiveConfig = {};

try {
    voiceLiveConfig = JSON.parse(configElement.textContent);
    console.log("Voice Live configuration loaded.");
} catch (error) {
    console.error("Invalid Voice Live configuration:", error);
}

const callButton = document.getElementById("callButton");
const message = document.getElementById("message");

callButton.addEventListener("click", () => {
    message.textContent =
        "UI is ready. WebRTC connection will be added next.";
});









* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;
    color: #132238;
    background:
        linear-gradient(135deg, #f6f9ff 0%, #eef4ff 100%);
}

button {
    font: inherit;
}

.application-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.top-header {
    min-height: 82px;
    padding: 16px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid #e4eaf3;
}

.brand,
.header-status,
.avatar-heading,
.panel-heading,
.transcription-row,
.call-controls,
.assistant-features,
.footer {
    display: flex;
    align-items: center;
}

.brand {
    gap: 14px;
}

.brand-logo {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 15px;
    color: white;
    font-size: 22px;
    font-weight: 800;
    background: linear-gradient(135deg, #00a9ce, #6438c8);
}

.brand-text h1,
.brand-text p,
.panel-heading h2,
.eyebrow,
.avatar-heading h2,
.welcome-card h3,
.welcome-card p,
.transcription-row p,
.call-message,
.footer p,
.avatar-placeholder p {
    margin: 0;
}

.brand-text h1 {
    font-size: 18px;
}

.brand-text p {
    margin-top: 3px;
    color: #6c798b;
    font-size: 13px;
}

.header-status {
    gap: 8px;
    color: #526174;
    font-size: 14px;
}

.status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
}

.status-dot.disconnected {
    background: #8d99a8;
}

.status-dot.connecting {
    background: #f59e0b;
}

.status-dot.connected {
    background: #10b981;
}

.workspace {
    width: min(1460px, 100%);
    margin: 0 auto;
    padding: 28px 36px;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(420px, 0.9fr);
    gap: 24px;
}

.conversation-panel,
.avatar-card {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid #e2e9f3;
    border-radius: 26px;
    box-shadow: 0 18px 55px rgba(40, 65, 110, 0.09);
}

.conversation-panel {
    padding: 26px;
    display: flex;
    flex-direction: column;
    min-height: 680px;
}

.panel-heading {
    justify-content: space-between;
    gap: 16px;
}

.eyebrow {
    color: #68778c;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.panel-heading h2,
.avatar-heading h2 {
    margin-top: 5px;
    font-size: 26px;
}

.call-duration {
    padding: 9px 14px;
    border: 1px solid #e1e7f0;
    border-radius: 12px;
    background: #f7f9fc;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
}

.transcript-container {
    margin-top: 22px;
    padding: 18px;
    flex: 1;
    overflow-y: auto;
    border-radius: 20px;
    background: #f7f9fd;
    border: 1px solid #e8edf5;
}

.welcome-card {
    display: flex;
    gap: 13px;
    padding: 17px;
    border-radius: 17px;
    background: white;
    border: 1px solid #e3eaf4;
}

.welcome-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 13px;
    color: white;
    background: linear-gradient(135deg, #00a9ce, #6438c8);
}

.welcome-card h3 {
    font-size: 16px;
}

.welcome-card p {
    margin-top: 5px;
    color: #677589;
    line-height: 1.55;
    font-size: 14px;
}

.live-transcription {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid #e5ebf3;
}

.transcription-row {
    align-items: flex-start;
    gap: 12px;
    padding: 7px 0;
}

.speaker-label {
    min-width: 48px;
    padding: 4px 7px;
    border-radius: 7px;
    text-align: center;
    font-size: 11px;
    font-weight: 800;
}

.user-label {
    color: #006c83;
    background: #dff8fd;
}

.assistant-label {
    color: #5529aa;
    background: #eee6ff;
}

.transcription-row p {
    color: #5d6b7e;
    line-height: 1.5;
    font-size: 14px;
}

.call-controls {
    margin-top: 20px;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
}

.call-button {
    min-width: 190px;
    padding: 14px 24px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    color: white;
    font-weight: 750;
    box-shadow: 0 12px 28px rgba(0, 139, 178, 0.23);
}

.call-button.start {
    background: linear-gradient(135deg, #00a9ce, #1773d1);
}

.call-button.end {
    background: linear-gradient(135deg, #ec3f57, #c92742);
}

.call-button:disabled {
    cursor: wait;
    opacity: 0.65;
}

.call-button-icon {
    margin-right: 7px;
}

.call-message {
    color: #667487;
    text-align: center;
    font-size: 13px;
}

.assistant-panel {
    position: relative;
    min-height: 680px;
}

.assistant-background-circle {
    position: absolute;
    width: 360px;
    height: 360px;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: rgba(91, 69, 210, 0.1);
    filter: blur(2px);
}

.avatar-card {
    height: 100%;
    padding: 26px;
    position: relative;
    z-index: 1;
}

.avatar-heading {
    justify-content: space-between;
}

.assistant-state {
    padding: 7px 11px;
    border-radius: 999px;
    color: #687589;
    background: #eff2f7;
    font-size: 12px;
    font-weight: 750;
}

.avatar-video-container {
    height: 515px;
    margin-top: 20px;
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background:
        radial-gradient(circle at 50% 35%, #eff2ff, #dce5f6);
}

#avatarVideo {
    width: 100%;
    height: 100%;
    display: none;
    object-fit: cover;
    background: #e9eef8;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: column;
}

.placeholder-avatar {
    width: 220px;
    height: 365px;
    position: relative;
}

.placeholder-head {
    width: 145px;
    height: 175px;
    margin: 0 auto;
    position: relative;
}

.placeholder-hair {
    position: absolute;
    inset: 0;
    border-radius: 52% 52% 43% 43%;
    background: #3c2a2d;
}

.placeholder-face {
    position: absolute;
    width: 104px;
    height: 132px;
    top: 25px;
    left: 21px;
    border-radius: 48% 48% 45% 45%;
    background: #d9a27e;
}

.placeholder-body {
    width: 210px;
    height: 210px;
    margin: -2px auto 0;
    border-radius: 52% 52% 12% 12%;
    background: linear-gradient(145deg, #31425e, #172439);
}

.avatar-loading {
    margin-top: 12px;
    display: none;
    gap: 6px;
}

.loading-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #5770d7;
    animation: loading 1s infinite alternate;
}

.loading-dot:nth-child(2) {
    animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes loading {
    from {
        transform: translateY(0);
        opacity: 0.45;
    }

    to {
        transform: translateY(-6px);
        opacity: 1;
    }
}

.avatar-placeholder p {
    margin-top: 13px;
    color: #617086;
    font-size: 14px;
}

.speaking-indicator {
    position: absolute;
    right: 18px;
    bottom: 18px;
    height: 34px;
    padding: 7px 10px;
    display: none;
    align-items: flex-end;
    gap: 4px;
    border-radius: 12px;
    background: rgba(19, 31, 52, 0.78);
}

.speaking-indicator span {
    width: 3px;
    height: 9px;
    border-radius: 3px;
    background: white;
    animation: speaking 0.6s infinite alternate;
}

.speaking-indicator span:nth-child(2) {
    animation-delay: 0.15s;
}

.speaking-indicator span:nth-child(3) {
    animation-delay: 0.3s;
}

.speaking-indicator span:nth-child(4) {
    animation-delay: 0.45s;
}

@keyframes speaking {
    to {
        height: 21px;
    }
}

.assistant-features {
    padding-top: 18px;
    justify-content: center;
    gap: 8px;
}

.assistant-features span {
    padding: 7px 10px;
    border-radius: 999px;
    color: #647185;
    background: #f0f3f8;
    font-size: 11px;
    font-weight: 700;
}

.footer {
    min-height: 48px;
    padding: 10px 36px;
    justify-content: space-between;
    color: #758195;
    border-top: 1px solid #e4eaf3;
    background: rgba(255, 255, 255, 0.85);
    font-size: 12px;
}

@media (max-width: 980px) {
    .workspace {
        grid-template-columns: 1fr;
    }

    .assistant-panel {
        min-height: 620px;
    }
}

@media (max-width: 620px) {
    .top-header,
    .workspace,
    .footer {
        padding-left: 16px;
        padding-right: 16px;
    }

    .brand-text p,
    .header-status,
    .footer p:last-child {
        display: none;
    }

    .workspace {
        padding-top: 16px;
    }

    .conversation-panel,
    .avatar-card {
        padding: 18px;
        border-radius: 20px;
    }

    .avatar-video-container {
        height: 430px;
    }
}



