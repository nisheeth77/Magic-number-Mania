import time
import uuid
from datetime import datetime, timezone

from agent_framework import Executor, WorkflowContext, handler
from hr_agent import HRAgent as HRCopilotAgent

from opentelemetry import trace
from opentelemetry.trace import Status, StatusCode

tracer = trace.get_tracer(__name__)


class HRAgent(Executor):

    def __init__(self, id):
        super().__init__(id=id)
        self.hr_agent = HRCopilotAgent()

    @handler
    async def process(self, message: str, context: WorkflowContext[str]):

        conversation_id = str(uuid.uuid4())
        request_id = str(uuid.uuid4())

        with tracer.start_as_current_span("copilotstudio.hr.invoke") as span:

            start = time.perf_counter()

            # ---------- Agent Details ----------
            span.set_attribute("copilotstudio.agent_name", "HR Agent")
            span.set_attribute("copilotstudio.agent_identifier", self.hr_agent.agent_identifier)
            span.set_attribute("copilotstudio.environment_id", self.hr_agent.environment_id)

            # Uncomment these only if they exist in hr_agent.py
            # span.set_attribute("copilotstudio.client_id", self.hr_agent.client_id)
            # span.set_attribute("copilotstudio.tenant_id", self.hr_agent.tenant_id)

            # ---------- Workflow ----------
            span.set_attribute("workflow.name", "HR and IT Workflow")
            span.set_attribute("executor.id", self.id)

            # ---------- Request ----------
            span.set_attribute("copilotstudio.prompt", message)
            span.set_attribute("copilotstudio.prompt_length", len(message))
            span.set_attribute("copilotstudio.request_id", request_id)
            span.set_attribute("copilotstudio.conversation_id", conversation_id)
            span.set_attribute(
                "copilotstudio.start_time",
                datetime.now(timezone.utc).isoformat()
            )

            try:

                print("Calling Copilot Studio HR Agent...")

                response = await self.hr_agent.ask(message)

                response_text = str(response)

                duration = (time.perf_counter() - start) * 1000

                # ---------- Response ----------
                span.set_attribute("copilotstudio.response", response_text)
                span.set_attribute("copilotstudio.response_length", len(response_text))
                span.set_attribute("copilotstudio.response_type", type(response).__name__)
                span.set_attribute(
                    "copilotstudio.end_time",
                    datetime.now(timezone.utc).isoformat()
                )
                span.set_attribute("copilotstudio.duration_ms", duration)

                # ---------- Status ----------
                span.set_attribute("copilotstudio.status", "Success")
                span.set_status(Status(StatusCode.OK))

                await context.yield_output(response_text)

            except Exception as ex:

                duration = (time.perf_counter() - start) * 1000

                span.set_attribute("copilotstudio.status", "Failed")
                span.set_attribute("copilotstudio.duration_ms", duration)
                span.set_attribute("copilotstudio.error.type", type(ex).__name__)
                span.set_attribute("copilotstudio.error.message", str(ex))

                span.record_exception(ex)
                span.set_status(Status(StatusCode.ERROR))

                raise
