<fragment>

    <!-- Unique correlation ID for this request -->
    <set-variable
        name="correlationId"
        value="@(
            context.Request.Headers.GetValueOrDefault(
                "x-correlation-id",
                context.RequestId.ToString()
            )
        )" />

    <!-- Request time in UTC -->
    <set-variable
        name="requestTimestamp"
        value="@(DateTime.UtcNow.ToString("o"))" />

    <!-- Used later to calculate total latency -->
    <set-variable
        name="startTime"
        value="@(DateTime.UtcNow.Ticks)" />

    <!-- Session ID supplied by client, otherwise generate one -->
    <set-variable
        name="sessionId"
        value="@{
            var sessionId =
                context.Request.Headers.GetValueOrDefault(
                    "x-session-id",
                    ""
                );

            return string.IsNullOrWhiteSpace(sessionId)
                ? Guid.NewGuid().ToString()
                : sessionId;
        }" />

    <!-- Extract user ID from JWT -->
    <set-variable
        name="userId"
        value="@{
            var authorization =
                context.Request.Headers.GetValueOrDefault(
                    "Authorization",
                    ""
                );

            var jwt = authorization.Replace("Bearer ", "");

            if (string.IsNullOrWhiteSpace(jwt))
            {
                return "anonymous";
            }

            try
            {
                var payload = jwt.AsJwt();

                return payload.Claims.GetValueOrDefault(
                    "oid",
                    "unknown"
                );
            }
            catch
            {
                return "invalid-token";
            }
        }" />

    <!-- Business attribution headers -->
    <set-variable
        name="teamId"
        value="@(
            context.Request.Headers.GetValueOrDefault(
                "x-team-id",
                "unassigned"
            )
        )" />

    <set-variable
        name="businessUnit"
        value="@(
            context.Request.Headers.GetValueOrDefault(
                "x-business-unit",
                "unassigned"
            )
        )" />

    <set-variable
        name="costCenter"
        value="@(
            context.Request.Headers.GetValueOrDefault(
                "x-cost-center",
                "unassigned"
            )
        )" />

    <set-variable
        name="agentId"
        value="@(
            context.Request.Headers.GetValueOrDefault(
                "x-agent-id",
                "direct-call"
            )
        )" />

    <!-- Model-routing information -->
    <set-variable
        name="modelProvider"
        value="@(
            context.Variables.GetValueOrDefault<string>(
                "modelProvider",
                "unknown"
            )
        )" />

    <set-variable
        name="modelName"
        value="@(
            context.Variables.GetValueOrDefault<string>(
                "modelName",
                "unknown"
            )
        )" />

    <set-variable
        name="modelDeployment"
        value="@(
            context.Variables.GetValueOrDefault<string>(
                "modelDeployment",
                "unknown"
            )
        )" />

    <set-variable
        name="regionRouted"
        value="@(context.Deployment.Region)" />

    <!-- Preserve request body so the backend still receives it -->
    <set-variable
        name="promptBody"
        value="@{
            var body =
                context.Request.Body?.As<string>(
                    preserveContent: true
                ) ?? "";

            return body.Length > 8000
                ? body.Substring(0, 8000) + "...[TRUNCATED]"
                : body;
        }" />

    <!-- Forward identifiers to backend -->
    <set-header
        name="x-correlation-id"
        exists-action="override">
        <value>@((string)context.Variables["correlationId"])</value>
    </set-header>

    <set-header
        name="x-session-id"
        exists-action="override">
        <value>@((string)context.Variables["sessionId"])</value>
    </set-header>

</fragment>









<fragment>

    <!-- Capture response without consuming it -->
    <set-variable name="responseBody" value="@{
        var body = context.Response.Body?.As<string>(preserveContent: true) ?? "";

        return body.Length > 8000
            ? body.Substring(0, 8000) + "...[TRUNCATED]"
            : body;
    }" />

    <!-- Calculate end-to-end latency -->
    <set-variable name="latencyMs" value="@{
        var start = context.Variables.GetValueOrDefault<long>(
            "startTime",
            DateTime.UtcNow.Ticks
        );

        return (DateTime.UtcNow.Ticks - start)
            / TimeSpan.TicksPerMillisecond;
    }" />

    <!-- Extract token usage from the model response -->
    <set-variable name="tokenUsage" value="@{
        try
        {
            var responseBody =
                context.Variables.GetValueOrDefault<string>(
                    "responseBody",
                    ""
                );

            if (string.IsNullOrWhiteSpace(responseBody))
            {
                return new JObject(
                    new JProperty("prompt", 0),
                    new JProperty("completion", 0),
                    new JProperty("total", 0)
                );
            }

            var json = responseBody.AsJObject();
            var usage = json["usage"];

            if (usage == null)
            {
                return new JObject(
                    new JProperty("prompt", 0),
                    new JProperty("completion", 0),
                    new JProperty("total", 0)
                );
            }

            var promptTokens =
                (int?)usage["prompt_tokens"]
                ?? (int?)usage["input_tokens"]
                ?? 0;

            var completionTokens =
                (int?)usage["completion_tokens"]
                ?? (int?)usage["output_tokens"]
                ?? 0;

            var totalTokens =
                (int?)usage["total_tokens"]
                ?? promptTokens + completionTokens;

            return new JObject(
                new JProperty("prompt", promptTokens),
                new JProperty("completion", completionTokens),
                new JProperty("total", totalTokens)
            );
        }
        catch
        {
            return new JObject(
                new JProperty("prompt", 0),
                new JProperty("completion", 0),
                new JProperty("total", 0)
            );
        }
    }" />

    <!-- Basic PII masking for the prompt -->
    <set-variable name="promptMasked" value="@{
        var prompt =
            context.Variables.GetValueOrDefault<string>(
                "promptBody",
                ""
            );

        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b",
            "[EMAIL]"
        );

        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @"\b\d{3}-\d{2}-\d{4}\b",
            "[SSN]"
        );

        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @"\b(?:\d[ -]*?){13,16}\b",
            "[CARD]"
        );

        prompt = System.Text.RegularExpressions.Regex.Replace(
            prompt,
            @"\+?\d[\d\s\-()]{8,14}\d",
            "[PHONE]"
        );

        return prompt;
    }" />

    <!-- Temporary trace for testing -->
    <trace source="AI-Gateway-Response" severity="information">
        <message>Outbound response metadata captured</message>

        <metadata
            name="CorrelationId"
            value="@(
                context.Variables.GetValueOrDefault<string>(
                    "correlationId",
                    "missing"
                )
            )" />

        <metadata
            name="SessionId"
            value="@(
                context.Variables.GetValueOrDefault<string>(
                    "sessionId",
                    "missing"
                )
            )" />

        <metadata
            name="LatencyMs"
            value="@(
                context.Variables
                    .GetValueOrDefault<long>("latencyMs", 0)
                    .ToString()
            )" />

        <metadata
            name="PromptTokens"
            value="@(
                ((int)((JObject)context.Variables["tokenUsage"])["prompt"])
                    .ToString()
            )" />

        <metadata
            name="CompletionTokens"
            value="@(
                ((int)((JObject)context.Variables["tokenUsage"])["completion"])
                    .ToString()
            )" />

        <metadata
            name="TotalTokens"
            value="@(
                ((int)((JObject)context.Variables["tokenUsage"])["total"])
                    .ToString()
            )" />

        <metadata
            name="HttpStatus"
            value="@(context.Response.StatusCode.ToString())" />
    </trace>

</fragment>
