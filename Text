from __future__ import annotations

import asyncio
import base64
import os
from contextlib import suppress
from pathlib import Path
from typing import Any

from azure.ai.voicelive.aio import AgentSessionConfig, connect
from azure.ai.voicelive.models import (
    InputAudioFormat,
    Modality,
    OutputAudioFormat,
    RequestSession,
    ServerEventType,
)
from azure.identity.aio import AzureCliCredential
from dotenv import load_dotenv
from fastapi import FastAPI, Request, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates


BASE_DIR = Path(__file__).resolve().parent

load_dotenv(BASE_DIR / ".env", override=True)

app = FastAPI(title="DU Voice Support Agent")

app.mount(
    "/static",
    StaticFiles(directory=BASE_DIR / "static"),
    name="static",
)

templates = Jinja2Templates(
    directory=BASE_DIR / "templates"
)


@app.get("/", response_class=HTMLResponse)
async def home(request: Request):
    return templates.TemplateResponse(
        request=request,
        name="index.html",
        context={},
    )


@app.get("/health")
async def health():
    return {"status": "healthy"}


def get_required_environment_variable(name: str) -> str:
    value = os.getenv(name)

    if not value:
        raise RuntimeError(
            f"Missing required environment variable: {name}"
        )

    return value


async def send_browser_status(
    websocket: WebSocket,
    status_type: str,
    message: str,
) -> None:
    try:
        await websocket.send_json(
            {
                "type": status_type,
                "message": message,
            }
        )
    except Exception:
        # The browser may already have disconnected.
        pass


async def browser_to_voice_live(
    websocket: WebSocket,
    voice_connection: Any,
) -> None:
    """
    Receive PCM16 audio from the browser and send it to Voice Live.
    """

    audio_chunk_count = 0

    while True:
        message = await websocket.receive()

        message_type = message.get("type")

        if message_type == "websocket.disconnect":
            print("Browser requested WebSocket disconnect")
            return

        audio_bytes = message.get("bytes")

        if audio_bytes:
            audio_chunk_count += 1

            # Voice Live expects Base64-encoded PCM16 data.
            encoded_audio = base64.b64encode(
                audio_bytes
            ).decode("utf-8")

            await voice_connection.input_audio_buffer.append(
                audio=encoded_audio
            )

            if audio_chunk_count % 20 == 0:
                print(
                    f"Sent {audio_chunk_count} PCM audio "
                    "chunks to Voice Live"
                )

        text_message = message.get("text")

        if text_message:
            print(f"Browser message: {text_message}")


async def voice_live_to_browser(
    websocket: WebSocket,
    voice_connection: Any,
) -> None:
    """
    Receive Voice Live events and send agent audio to the browser.
    """

    active_response = False
    response_finished = True

    async for event in voice_connection:
        event_type = event.type

        if event_type == ServerEventType.SESSION_UPDATED:
            print("Voice Live session ready")

            await send_browser_status(
                websocket,
                "ready",
                "Connected to DU Voice Agent. You can start speaking.",
            )

        elif (
            event_type
            == ServerEventType.INPUT_AUDIO_BUFFER_SPEECH_STARTED
        ):
            print("User started speaking")

            await send_browser_status(
                websocket,
                "listening",
                "Listening...",
            )

            # Barge-in: stop current browser playback.
            await send_browser_status(
                websocket,
                "clear-audio",
                "clear",
            )

            if active_response and not response_finished:
                with suppress(Exception):
                    await voice_connection.response.cancel()

        elif (
            event_type
            == ServerEventType.INPUT_AUDIO_BUFFER_SPEECH_STOPPED
        ):
            print("User stopped speaking")

            await send_browser_status(
                websocket,
                "processing",
                "Processing your request...",
            )

        elif event_type == ServerEventType.RESPONSE_CREATED:
            active_response = True
            response_finished = False

            await send_browser_status(
                websocket,
                "speaking",
                "DU Assistant is responding...",
            )

        elif event_type == ServerEventType.RESPONSE_AUDIO_DELTA:
            # event.delta contains PCM16 audio generated by the agent.
            if event.delta:
                await websocket.send_bytes(event.delta)

        elif event_type == ServerEventType.RESPONSE_AUDIO_DONE:
            print("Agent finished speaking")

            await send_browser_status(
                websocket,
                "ready",
                "Ready for your next question.",
            )

        elif event_type == ServerEventType.RESPONSE_DONE:
            active_response = False
            response_finished = True

        elif (
            event_type
            == ServerEventType
            .CONVERSATION_ITEM_INPUT_AUDIO_TRANSCRIPTION_COMPLETED
        ):
            transcript = event.get("transcript", "")

            if transcript:
                print(f"User: {transcript}")

                await websocket.send_json(
                    {
                        "type": "user-transcript",
                        "text": transcript,
                    }
                )

        elif (
            event_type
            == ServerEventType.RESPONSE_AUDIO_TRANSCRIPT_DONE
        ):
            transcript = event.get("transcript", "")

            if transcript:
                print(f"Agent: {transcript}")

                await websocket.send_json(
                    {
                        "type": "agent-transcript",
                        "text": transcript,
                    }
                )

        elif event_type == ServerEventType.ERROR:
            error_message = getattr(
                event.error,
                "message",
                "Unknown Voice Live error",
            )

            print(f"Voice Live error: {error_message}")

            await send_browser_status(
                websocket,
                "error",
                error_message,
            )


@app.websocket("/ws/voice")
async def voice_websocket(websocket: WebSocket):
    await websocket.accept()

    print("Browser WebSocket connected")

    credential: AzureCliCredential | None = None

    try:
        endpoint = get_required_environment_variable(
            "VOICELIVE_ENDPOINT"
        )

        project_name = get_required_environment_variable(
            "PROJECT_NAME"
        )

        agent_name = get_required_environment_variable(
            "AGENT_NAME"
        )

        agent_version = os.getenv("AGENT_VERSION")

        api_version = os.getenv(
            "VOICELIVE_API_VERSION",
            "2026-01-01-preview",
        )

        agent_config: AgentSessionConfig = {
            "agent_name": agent_name,
            "project_name": project_name,
            "agent_version": (
                agent_version if agent_version else None
            ),
        }

        await send_browser_status(
            websocket,
            "connecting",
            "Connecting to DU Voice Agent...",
        )

        credential = AzureCliCredential()

        async with connect(
            endpoint=endpoint,
            credential=credential,
            api_version=api_version,
            agent_config=agent_config,
        ) as voice_connection:

            print("Connected to Azure Voice Live")

            session_configuration = RequestSession(
                modalities=[
                    Modality.TEXT,
                    Modality.AUDIO,
                ],
                input_audio_format=InputAudioFormat.PCM16,
                output_audio_format=OutputAudioFormat.PCM16,
            )

            await voice_connection.session.update(
                session=session_configuration
            )

            browser_task = asyncio.create_task(
                browser_to_voice_live(
                    websocket,
                    voice_connection,
                )
            )

            azure_task = asyncio.create_task(
                voice_live_to_browser(
                    websocket,
                    voice_connection,
                )
            )

            done, pending = await asyncio.wait(
                {
                    browser_task,
                    azure_task,
                },
                return_when=asyncio.FIRST_COMPLETED,
            )

            for task in pending:
                task.cancel()

            for task in pending:
                with suppress(asyncio.CancelledError):
                    await task

            for task in done:
                exception = task.exception()

                if exception:
                    raise exception

    except WebSocketDisconnect:
        print("Browser WebSocket disconnected")

    except Exception as error:
        print(f"Voice bridge error: {error}")

        await send_browser_status(
            websocket,
            "error",
            str(error),
        )

    finally:
        if credential:
            await credential.close()

        with suppress(Exception):
            await websocket.close()

        print("Voice session closed")
