import tracing  # Must be imported first to enable MAF tracing

import asyncio

from agent_framework import WorkflowBuilder
from executors import HRAgent, ITAgent


async def main():
    # Create workflow executors
    hr = HRAgent(id="hr")
    it = ITAgent(id="it")

    # Build the MAF workflow
    workflow = (
        WorkflowBuilder(
            start_executor=hr,
            name="HR and IT Workflow",
        )
        .add_edge(hr, it)
        .build()
    )

    # Run the workflow
    result = await workflow.run("Hello from HR")

    print(result)


if __name__ == "__main__":
    asyncio.run(main())
