{
  "openapi": "3.0.0",
  "info": {
    "title": "Sales Forecast API",
    "description": "Predicts future revenue and sales using ML model",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://retail-forecast-endpoint.eastus.inference.ml.azure.com"
    }
  ],
  "paths": {
    "/score": {
      "post": {
        "operationId": "getSalesForecast",
        "summary": "Predict future sales/revenue",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "store_id": { "type": "string" },
                  "product_id": { "type": "string" },
                  "forecast_days": { "type": "integer", "example": 7 },
                  "historical_sales": {
                    "type": "array",
                    "items": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful prediction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "forecast": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": { "type": "string" },
                          "predicted_sales": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  }
}
