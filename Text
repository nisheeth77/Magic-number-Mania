function openSignalingSocket(url) {
    return new Promise((resolve, reject) => {
        const socketUrl = getWebSocketUrl(url);

        log(`Opening signaling socket: ${socketUrl}`);

        signalingSocket = new WebSocket(socketUrl);

        let completed = false;

        const timeoutId = window.setTimeout(() => {
            if (completed) {
                return;
            }

            completed = true;

            reject(
                new Error(
                    "Timed out while connecting to the backend."
                )
            );
        }, 15000);

        signalingSocket.onopen = () => {
            log("Backend signaling socket opened");
        };

        signalingSocket.onmessage = (event) => {
            let message;

            try {
                message = JSON.parse(event.data);
            } catch (error) {
                log(
                    "Received non-JSON signaling message",
                    event.data
                );
                return;
            }

            handleVoiceLiveEvent(
                message,
                "signaling"
            );

            if (
                !completed &&
                message.type === "proxy.connected"
            ) {
                completed = true;
                window.clearTimeout(timeoutId);
                resolve();
            }
        };

        signalingSocket.onerror = () => {
            if (!completed) {
                completed = true;
                window.clearTimeout(timeoutId);

                reject(
                    new Error(
                        "Backend signaling connection failed."
                    )
                );
            }
        };

        signalingSocket.onclose = (event) => {
            log(
                `Signaling socket closed: ${event.code}`
            );

            if (!completed) {
                completed = true;
                window.clearTimeout(timeoutId);

                reject(
                    new Error(
                        "Signaling socket closed before connecting."
                    )
                );
            }
        };
    });
}

function waitForSdpAnswer(timeoutMilliseconds = 30000) {
    return new Promise((resolve, reject) => {
        const timeoutId = window.setTimeout(() => {
            cleanup();

            reject(
                new Error(
                    "Timed out waiting for Azure SDP answer."
                )
            );
        }, timeoutMilliseconds);

        const messageHandler = (event) => {
            let message;

            try {
                message = JSON.parse(event.data);
            } catch {
                return;
            }

            if (
                message.type ===
                "rtc.call.sdp.created"
            ) {
                cleanup();
                resolve(message);
                return;
            }

            if (
                message.type === "rtc.call.error" ||
                message.type === "proxy.error" ||
                message.type === "error"
            ) {
                cleanup();

                const errorMessage =
                    message.error?.message ||
                    message.message ||
                    "Voice Live signaling failed.";

                reject(new Error(errorMessage));
            }
        };

        const closeHandler = () => {
            cleanup();

            reject(
                new Error(
                    "Signaling socket closed before SDP negotiation completed."
                )
            );
        };

        function cleanup() {
            window.clearTimeout(timeoutId);

            if (signalingSocket) {
                signalingSocket.removeEventListener(
                    "message",
                    messageHandler
                );

                signalingSocket.removeEventListener(
                    "close",
                    closeHandler
                );
            }
        }

        signalingSocket.addEventListener(
            "message",
            messageHandler
        );

        signalingSocket.addEventListener(
            "close",
            closeHandler
        );
    });
}


