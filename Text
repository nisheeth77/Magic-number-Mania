# ============================================================
# Environment configuration
# ============================================================

load_dotenv()

VOICE_LIVE_ENDPOINT = os.getenv("VOICELIVE_ENDPOINT", "").rstrip("/")
VOICE_LIVE_API_VERSION = os.getenv(
    "VOICELIVE_API_VERSION",
    "2026-04-10",
)

PROJECT_NAME = os.getenv("PROJECT_NAME", "").strip()
AGENT_NAME = os.getenv("AGENT_NAME", "").strip()
AGENT_VERSION = os.getenv("AGENT_VERSION", "").strip()

HOST = os.getenv("HOST", "127.0.0.1")
PORT = int(os.getenv("PORT", "8000"))

AZURE_TOKEN_SCOPE = "https://ai.azure.com/.default"

logging.basicConfig(
    level=logging.INFO,
