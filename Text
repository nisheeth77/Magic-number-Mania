import tracing  # Must remain first

import asyncio

from agent_framework import WorkflowBuilder
from executors import HRAgent, ITAgent
from opentelemetry import trace
from opentelemetry.trace import Status, StatusCode


tracer = trace.get_tracer("maf-copilot-orchestrator")


async def main():

    hr = HRAgent(id="hr")
    it = ITAgent(id="it")

    workflow = (
        WorkflowBuilder(
            start_executor=hr,
            name="HR and IT Workflow",
        )
        .add_edge(hr, it)
        .build()
    )

    provider = trace.get_tracer_provider()

    try:
        # Manual parent span
        with tracer.start_as_current_span(
            "workflow.run.manual"
        ) as span:

            span.set_attribute(
                "workflow.name",
                "HR and IT Workflow"
            )

            span.set_attribute(
                "workflow.input",
                "Tell me about code of conduct"
            )

            try:
                result = await workflow.run(
                    "Tell me about code of conduct"
                )

                span.set_attribute(
                    "workflow.status",
                    "Success"
                )

                span.set_status(
                    Status(StatusCode.OK)
                )

                print(result)

            except Exception as error:

                span.set_attribute(
                    "workflow.status",
                    "Failed"
                )

                span.set_attribute(
                    "workflow.error.type",
                    type(error).__name__
                )

                span.set_attribute(
                    "workflow.error.message",
                    str(error)
                )

                span.record_exception(error)

                span.set_status(
                    Status(
                        StatusCode.ERROR,
                        str(error)
                    )
                )

                raise

    finally:
        if hasattr(provider, "force_flush"):
            print("Flushing telemetry...")

            provider.force_flush(
                timeout_millis=10000
            )

            print("Telemetry flushed")


if __name__ == "__main__":
    asyncio.run(main())
