async def ask(self, question: str) -> str:
    tracer = trace.get_tracer("copilotstudio-agent")

    # Explicitly create an independent root span
    span = tracer.start_span(
        "copilotstudio.hr.invoke",
        context=Context(),
    )

    print(
        "copilotstudio.hr.invoke recording:",
        span.is_recording()
    )

    start_time = time.perf_counter()

    with trace.use_span(
        span,
        end_on_exit=True,
    ):
        try:
            span.set_attribute(
                "copilotstudio.agent_name",
                "HR Agent",
            )

            span.set_attribute(
                "copilotstudio.prompt",
                question,
            )

            span.set_attribute(
                "copilotstudio.prompt_length",
                len(question),
            )

            response = await self.agent.run(question)

            response_text = str(response)

            span.set_attribute(
                "copilotstudio.response",
                response_text,
            )

            span.set_attribute(
                "copilotstudio.response_length",
                len(response_text),
            )

            span.set_attribute(
                "copilotstudio.duration_ms",
                (time.perf_counter() - start_time) * 1000,
            )

            span.set_attribute(
                "copilotstudio.status",
                "success",
            )

            span.set_status(
                Status(StatusCode.OK)
            )

            return response_text

        except Exception as error:
            span.set_attribute(
                "copilotstudio.status",
                "failed",
            )

            span.set_attribute(
                "copilotstudio.error_type",
                type(error).__name__,
            )

            span.set_attribute(
                "copilotstudio.error_message",
                str(error),
            )

            span.record_exception(error)

            span.set_status(
                Status(
                    StatusCode.ERROR,
                    str(error),
                )
            )

            raise
