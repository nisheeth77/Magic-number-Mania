import tracing
import asyncio

from agent_framework import WorkflowBuilder
from executors import HRAgent, ITAgent


async def main():
    hr = HRAgent(id="hr")
    it = ITAgent(id="it")

    workflow = (
        WorkflowBuilder(
            start_executor=hr,
            name="HR and IT Workflow",
            output_from="all",
        )
        .add_edge(hr, it)
        .build()
    )

    result = await workflow.run("Hello from HR")
    print(result)


if __name__ == "__main__":
    asyncio.run(main())
