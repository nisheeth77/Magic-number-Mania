from opentelemetry import trace

from agent_framework import Executor, WorkflowContext, handler
from hr_agent import HRAgent as HRCopilotAgent


tracer = trace.get_tracer("maf-copilot-orchestrator")


class HRAgent(Executor):
    def __init__(self, id: str):
        super().__init__(id=id)
        self.hr_agent = HRCopilotAgent()

    @handler
    async def process(
        self,
        message: str,
        context: WorkflowContext[str],
    ) -> None:
        print("Calling Copilot Studio HR Agent...")

        with tracer.start_as_current_span(
            "copilotstudio.hr.invoke"
        ) as span:
            span.set_attribute("copilotstudio.prompt", message)

            try:
                response = await self.hr_agent.ask(message)
                response_text = str(response)

                span.set_attribute(
                    "copilotstudio.response",
                    response_text,
                )
                span.set_attribute(
                    "copilotstudio.status",
                    "success",
                )

                await context.yield_output(response_text)

            except Exception as error:
                span.set_attribute(
                    "copilotstudio.status",
                    "failed",
                )
                span.record_exception(error)
                span.set_status(
                    trace.Status(
                        trace.StatusCode.ERROR,
                        str(error),
                    )
                )
                raise


class ITAgent(Executor):
    @handler
    async def process(
        self,
        message: str,
        context: WorkflowContext[str],
    ) -> None:
        print("Processing ITAgentExecutor...")
        await context.yield_output(f"IT Response: {message}")
