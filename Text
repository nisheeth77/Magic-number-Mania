# ============================================================
# Validation and URL generation
# ============================================================

def validate_environment() -> None:
    missing = []

    if not VOICE_LIVE_ENDPOINT:
        missing.append("VOICELIVE_ENDPOINT")

    if not PROJECT_NAME:
        missing.append("PROJECT_NAME")

    if not AGENT_NAME:
        missing.append("AGENT_NAME")

    if missing:
        raise RuntimeError(
            "Missing environment variables: " + ", ".join(missing)
        )

    if not VOICE_LIVE_ENDPOINT.startswith(
        ("https://", "http://")
    ):
        raise RuntimeError(
            "VOICELIVE_ENDPOINT must start with https:// or http://"
        )


def build_azure_control_url() -> str:
    """
    Build the Voice Live WebRTC control-channel URL.

    Example:
    wss://resource.services.ai.azure.com/voice-live/realtime/calls
        ?api-version=2026-04-10
        &agent-project-name=du-telco
        &agent-name=VoiceAgentDUTelco
        &agent-version=23
    """

    if VOICE_LIVE_ENDPOINT.startswith("https://"):
        ws_endpoint = (
            "wss://"
            + VOICE_LIVE_ENDPOINT.removeprefix("https://")
        )
    else:
        ws_endpoint = (
            "ws://"
            + VOICE_LIVE_ENDPOINT.removeprefix("http://")
        )

    query = {
        "api-version": VOICE_LIVE_API_VERSION,
        "agent-project-name": PROJECT_NAME,
        "agent-name": AGENT_NAME,
    }

    if AGENT_VERSION:
        query["agent-version"] = AGENT_VERSION

    return (
        f"{ws_endpoint}/voice-live/realtime/calls?"
        f"{urlencode(query)}"
    )


# ============================================================
# FastAPI lifecycle
# ============================================================

@asynccontextmanager
async def lifespan(app: FastAPI):
    validate_environment()

    credential = AzureCliCredential()
    http_session = aiohttp.ClientSession()

    app.state.azure_credential = credential
    app.state.http_session = http_session

    logger.info("Voice Avatar backend started")
    logger.info("Endpoint: %s", VOICE_LIVE_ENDPOINT)
    logger.info("Project: %s", PROJECT_NAME)
    logger.info("Agent: %s", AGENT_NAME)
    logger.info("Agent version: %s", AGENT_VERSION or "latest")
    logger.info("API version: %s", VOICE_LIVE_API_VERSION)

    try:
        yield
    finally:
        await http_session.close()
        await credential.close()
        logger.info("Voice Avatar backend stopped")


app = FastAPI(
