import time
import uuid
from datetime import datetime, timezone

from agent_framework import Executor, WorkflowContext, handler
from hr_agent import HRAgent as HRCopilotAgent

from opentelemetry import trace
from opentelemetry.trace import Status, StatusCode


class HRAgent(Executor):

    def __init__(self, id: str):
        super().__init__(id=id)
        self.hr_agent = HRCopilotAgent()

    @handler
    async def process(
        self,
        message: str,
        context: WorkflowContext[str],
    ) -> None:

        # Get the tracer here, after tracing.py has configured Azure Monitor
        tracer = trace.get_tracer(
            "maf-copilot-orchestrator"
        )

        conversation_id = str(uuid.uuid4())
        request_id = str(uuid.uuid4())

        with tracer.start_as_current_span(
            "copilotstudio.hr.invoke"
        ) as span:

            print(
                "copilotstudio.hr.invoke recording:",
                span.is_recording()
            )

            start = time.perf_counter()
            start_time = datetime.now(
                timezone.utc
            ).isoformat()

            # Agent details
            span.set_attribute(
                "copilotstudio.agent_name",
                "HR Agent"
            )

            span.set_attribute(
                "copilotstudio.agent_identifier",
                getattr(
                    self.hr_agent,
                    "agent_identifier",
                    "HR Copilot Agent"
                )
            )

            span.set_attribute(
                "copilotstudio.environment_id",
                getattr(
                    self.hr_agent,
                    "environment_id",
                    "Not exposed"
                )
            )

            # Workflow details
            span.set_attribute(
                "workflow.name",
                "HR and IT Workflow"
            )

            span.set_attribute(
                "executor.id",
                self.id
            )

            # Request details
            span.set_attribute(
                "copilotstudio.prompt",
                str(message)
            )

            span.set_attribute(
                "copilotstudio.prompt_length",
                len(str(message))
            )

            span.set_attribute(
                "copilotstudio.request_id",
                request_id
            )

            span.set_attribute(
                "copilotstudio.conversation_id",
                conversation_id
            )

            span.set_attribute(
                "copilotstudio.start_time",
                start_time
            )

            try:
                print("Calling Copilot Studio HR Agent...")

                response = await self.hr_agent.ask(
                    message
                )

                response_text = str(response)

                duration_ms = (
                    time.perf_counter() - start
                ) * 1000

                # Response details
                span.set_attribute(
                    "copilotstudio.response",
                    response_text
                )

                span.set_attribute(
                    "copilotstudio.response_length",
                    len(response_text)
                )

                span.set_attribute(
                    "copilotstudio.response_type",
                    type(response).__name__
                )

                span.set_attribute(
                    "copilotstudio.end_time",
                    datetime.now(
                        timezone.utc
                    ).isoformat()
                )

                span.set_attribute(
                    "copilotstudio.duration_ms",
                    duration_ms
                )

                span.set_attribute(
                    "copilotstudio.status",
                    "Success"
                )

                span.set_status(
                    Status(StatusCode.OK)
                )

                await context.yield_output(
                    response_text
                )

            except Exception as error:
                duration_ms = (
                    time.perf_counter() - start
                ) * 1000

                span.set_attribute(
                    "copilotstudio.end_time",
                    datetime.now(
                        timezone.utc
                    ).isoformat()
                )

                span.set_attribute(
                    "copilotstudio.duration_ms",
                    duration_ms
                )

                span.set_attribute(
                    "copilotstudio.status",
                    "Failed"
                )

                span.set_attribute(
                    "copilotstudio.error.type",
                    type(error).__name__
                )

                span.set_attribute(
                    "copilotstudio.error.message",
                    str(error)
                )

                span.record_exception(error)

                span.set_status(
                    Status(
                        StatusCode.ERROR,
                        str(error)
                    )
                )

                raise


class ITAgent(Executor):

    def __init__(self, id: str):
        super().__init__(id=id)

    @handler
    async def process(
        self,
        message: str,
        context: WorkflowContext[str],
    ) -> None:

        print("Processing ITAgentExecutor...")

        await context.yield_output(
            f"IT Response: {message}"
        )








# This must be the first project import
import tracing

import asyncio

from opentelemetry import trace
from agent_framework import WorkflowBuilder

from executors import HRAgent, ITAgent


async def main():

    hr = HRAgent(id="hr")
    it = ITAgent(id="it")

    workflow = (
        WorkflowBuilder(
            start_executor=hr,
            name="HR and IT Workflow",
        )
        .add_edge(hr, it)
        .build()
    )

    try:
        result = await workflow.run(
            "Tell me about code of conduct"
        )

        print("\nWorkflow result:")
        print(result)

    except Exception as error:
        print("\nWorkflow failed:")
        print(error)

    finally:
        # Important for short-running console applications
        provider = trace.get_tracer_provider()

        force_flush = getattr(
            provider,
            "force_flush",
            None
        )

        if callable(force_flush):
            print("Flushing telemetry...")

            flushed = force_flush(
                timeout_millis=15000
            )

            print(
                "Telemetry flush result:",
                flushed
            )


if __name__ == "__main__":
    asyncio.run(main())



