app.py


import asyncio
import json
import logging
import os
from contextlib import asynccontextmanager
from typing import Optional
from urllib.parse import urlencode

import aiohttp
import uvicorn
from azure.identity.aio import AzureCliCredential
from dotenv import load_dotenv
from fastapi import FastAPI, Request, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

load_dotenv()

VOICE_LIVE_ENDPOINT = os.getenv("VOICELIVE_ENDPOINT", "").rstrip("/")
VOICE_LIVE_API_VERSION = os.getenv(
    "VOICELIVE_API_VERSION",
    "2026-04-10",
)

PROJECT_NAME = os.getenv("PROJECT_NAME", "")
AGENT_NAME = os.getenv("AGENT_NAME", "")
AGENT_VERSION = os.getenv("AGENT_VERSION") or None

HOST = os.getenv("HOST", "127.0.0.1")
PORT = int(os.getenv("PORT", "8000"))

TOKEN_SCOPE = "https://ai.azure.com/.default"

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
)

logger = logging.getLogger("voice-avatar")


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

def validate_environment() -> None:
    missing = []

    if not VOICE_LIVE_ENDPOINT:
        missing.append("VOICELIVE_ENDPOINT")

    if not PROJECT_NAME:
        missing.append("PROJECT_NAME")

    if not AGENT_NAME:
        missing.append("AGENT_NAME")

    if missing:
        raise RuntimeError(
            "Missing required environment variables: "
            + ", ".join(missing)
        )


def build_voice_live_websocket_url() -> str:
    """
    Builds the Azure Voice Live WebRTC signaling URL.

    The browser sends its WebRTC SDP offer to this FastAPI backend.
    This backend forwards it to Azure through the /realtime/calls endpoint.
    """

    endpoint = VOICE_LIVE_ENDPOINT

    if endpoint.startswith("https://"):
        websocket_base = "wss://" + endpoint[len("https://"):]
    elif endpoint.startswith("http://"):
        websocket_base = "ws://" + endpoint[len("http://"):]
    else:
        raise RuntimeError(
            "VOICELIVE_ENDPOINT must start with https:// or http://"
        )

    query = {
        "api-version": VOICE_LIVE_API_VERSION,
        "agent-name": AGENT_NAME,
        "agent-project-name": PROJECT_NAME,
    }

    if AGENT_VERSION:
        query["agent-version"] = AGENT_VERSION

    return (
        f"{websocket_base}/voice-live/realtime/calls?"
        f"{urlencode(query)}"
    )


# ---------------------------------------------------------------------------
# Application lifecycle
# ---------------------------------------------------------------------------

@asynccontextmanager
async def lifespan(app: FastAPI):
    validate_environment()

    credential = AzureCliCredential()
    http_session = aiohttp.ClientSession()

    app.state.credential = credential
    app.state.http_session = http_session

    logger.info("Voice Avatar backend started")
    logger.info("Voice Live endpoint: %s", VOICE_LIVE_ENDPOINT)
    logger.info("Project: %s", PROJECT_NAME)
    logger.info("Agent: %s", AGENT_NAME)
    logger.info("Agent version: %s", AGENT_VERSION or "latest")
    logger.info("API version: %s", VOICE_LIVE_API_VERSION)

    try:
        yield
    finally:
        await http_session.close()
        await credential.close()
        logger.info("Voice Avatar backend stopped")


app = FastAPI(
    title="DU Voice Avatar",
    version="1.0.0",
    lifespan=lifespan,
)


# ---------------------------------------------------------------------------
# Static frontend
# ---------------------------------------------------------------------------

app.mount(
    "/static",
    StaticFiles(directory="static"),
    name="static",
)

templates = Jinja2Templates(directory="templates")


# ---------------------------------------------------------------------------
# HTTP routes
# ---------------------------------------------------------------------------

@app.get("/", response_class=HTMLResponse)
async def home(request: Request):
    return templates.TemplateResponse(
        request=request,
        name="index.html",
        context={
            "request": request,
        },
    )


@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "project_name": PROJECT_NAME,
        "agent_name": AGENT_NAME,
        "agent_version": AGENT_VERSION,
        "api_version": VOICE_LIVE_API_VERSION,
    }


@app.get("/config")
async def frontend_config():
    """
    Returns only non-secret frontend configuration.

    Azure tokens and API keys are never returned to the browser.
    """

    return JSONResponse(
        {
            "signalingUrl": "/ws/signaling",
            "avatar": {
                "character": "lisa",
                "customized": False,
                "outputProtocol": "webrtc",
                "resolution": {
                    "width": 1280,
                    "height": 720,
                },
            },
        }
    )


# ---------------------------------------------------------------------------
# WebSocket forwarding helpers
# ---------------------------------------------------------------------------

async def browser_to_azure(
    browser_ws: WebSocket,
    azure_ws: aiohttp.ClientWebSocketResponse,
) -> None:
    """
    Forward signaling and session messages from the browser to Azure.
    """

    while True:
        message = await browser_ws.receive()

        message_type = message.get("type")

        if message_type == "websocket.disconnect":
            break

        text = message.get("text")

        if text is not None:
            # Validate that the message is valid JSON before forwarding.
            try:
                payload = json.loads(text)
            except json.JSONDecodeError:
                await browser_ws.send_json(
                    {
                        "type": "proxy.error",
                        "error": {
                            "message": "Browser sent invalid JSON."
                        },
                    }
                )
                continue

            logger.debug(
                "Browser -> Azure: %s",
                payload.get("type", "unknown"),
            )

            await azure_ws.send_str(
                json.dumps(payload)
            )

        binary = message.get("bytes")

        if binary is not None:
            await azure_ws.send_bytes(binary)


async def azure_to_browser(
    azure_ws: aiohttp.ClientWebSocketResponse,
    browser_ws: WebSocket,
) -> None:
    """
    Forward Azure Voice Live events back to the browser.
    """

    async for message in azure_ws:
        if message.type == aiohttp.WSMsgType.TEXT:
            try:
                payload = json.loads(message.data)

                logger.debug(
                    "Azure -> Browser: %s",
                    payload.get("type", "unknown"),
                )

                await browser_ws.send_json(payload)

            except json.JSONDecodeError:
                await browser_ws.send_text(message.data)

        elif message.type == aiohttp.WSMsgType.BINARY:
            await browser_ws.send_bytes(message.data)

        elif message.type == aiohttp.WSMsgType.ERROR:
            error = azure_ws.exception()

            logger.error(
                "Azure WebSocket error: %s",
                error,
            )

            await browser_ws.send_json(
                {
                    "type": "proxy.error",
                    "error": {
                        "message": str(error)
                    },
                }
            )
            break

        elif message.type in {
            aiohttp.WSMsgType.CLOSE,
            aiohttp.WSMsgType.CLOSED,
            aiohttp.WSMsgType.CLOSING,
        }:
            break


# ---------------------------------------------------------------------------
# WebRTC signaling WebSocket
# ---------------------------------------------------------------------------

@app.websocket("/ws/signaling")
async def signaling_websocket(browser_ws: WebSocket):
    await browser_ws.accept()

    azure_ws: Optional[aiohttp.ClientWebSocketResponse] = None

    try:
        credential: AzureCliCredential = (
            browser_ws.app.state.credential
        )

        http_session: aiohttp.ClientSession = (
            browser_ws.app.state.http_session
        )

        logger.info("Getting Azure access token")

        token = await credential.get_token(TOKEN_SCOPE)

        azure_url = build_voice_live_websocket_url()

        logger.info("Connecting to Azure Voice Live WebRTC signaling")

        azure_ws = await http_session.ws_connect(
            azure_url,
            headers={
                "Authorization": f"Bearer {token.token}",
            },
            protocols=["realtime"],
            heartbeat=30,
            receive_timeout=None,
            max_msg_size=16 * 1024 * 1024,
        )

        await browser_ws.send_json(
            {
                "type": "proxy.connected",
                "agent": {
                    "name": AGENT_NAME,
                    "project": PROJECT_NAME,
                    "version": AGENT_VERSION,
                },
            }
        )

        browser_task = asyncio.create_task(
            browser_to_azure(
                browser_ws,
                azure_ws,
            )
        )

        azure_task = asyncio.create_task(
            azure_to_browser(
                azure_ws,
                browser_ws,
            )
        )

        done, pending = await asyncio.wait(
            {browser_task, azure_task},
            return_when=asyncio.FIRST_COMPLETED,
        )

        for task in pending:
            task.cancel()

        await asyncio.gather(
            *pending,
            return_exceptions=True,
        )

        for task in done:
            exception = task.exception()

            if exception:
                raise exception

    except WebSocketDisconnect:
        logger.info("Browser disconnected")

    except aiohttp.WSServerHandshakeError as exc:
        logger.exception(
            "Azure rejected the WebSocket connection"
        )

        try:
            await browser_ws.send_json(
                {
                    "type": "proxy.error",
                    "error": {
                        "message": (
                            "Azure rejected the Voice Live connection. "
                            f"HTTP status: {exc.status}"
                        )
                    },
                }
            )
        except Exception:
            pass

    except Exception as exc:
        logger.exception(
            "Voice Live signaling failed"
        )

        try:
            await browser_ws.send_json(
                {
                    "type": "proxy.error",
                    "error": {
                        "message": str(exc)
                    },
                }
            )
        except Exception:
            pass

    finally:
        if azure_ws is not None and not azure_ws.closed:
            await azure_ws.close()

        try:
            await browser_ws.close()
        except Exception:
            pass

        logger.info("Signaling session closed")


