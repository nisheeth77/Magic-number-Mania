import asyncio
import os

from azure.ai.voicelive.aio import AgentSessionConfig, connect
from azure.identity.aio import AzureCliCredential
from dotenv import load_dotenv


load_dotenv()


async def main() -> None:
    endpoint = os.getenv("VOICELIVE_ENDPOINT")
    agent_name = os.getenv("AGENT_NAME")
    project_name = os.getenv("PROJECT_NAME")
    agent_version = os.getenv("AGENT_VERSION")

    if not endpoint:
        raise ValueError("VOICELIVE_ENDPOINT is missing from .env")

    if not agent_name:
        raise ValueError("AGENT_NAME is missing from .env")

    if not project_name:
        raise ValueError("PROJECT_NAME is missing from .env")

    # AgentSessionConfig is a typed dictionary, not a class constructor.
    agent_config: AgentSessionConfig = {
        "agent_name": agent_name,
        "project_name": project_name,
        "agent_version": agent_version or None,
    }

    credential = AzureCliCredential()

    try:
        print("Connecting to the DU voice agent...")
        print(f"Agent: {agent_name}")
        print(f"Project: {project_name}")
        print(f"Version: {agent_version or 'latest'}")

        async with connect(
            endpoint=endpoint,
            credential=credential,
            api_version="2026-01-01-preview",
            agent_config=agent_config,
        ):
            print("Connection successful.")

    finally:
        await credential.close()


if __name__ == "__main__":
    asyncio.run(main())
