<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DU Voice Support Agent</title>

    <link rel="stylesheet"
          href="{{ url_for('static', path='style.css') }}">
</head>

<body>

<div class="app-container">

    <div class="agent-card">

        <!-- Status -->
        <div class="status-row">

            <div class="status-left">

                <span id="statusDot"
                      class="status-dot"></span>

                <span id="connectionStatus">
                    Ready
                </span>

            </div>

            <div class="brand">
                Microsoft Foundry
            </div>

        </div>


        <!-- Avatar -->

        <div class="avatar-wrapper">

            <div class="avatar">

                🤖

            </div>

        </div>


        <!-- Title -->

        <h1 class="title">
            DU Virtual Support
        </h1>

        <p class="subtitle">

            Azure AI Foundry Voice Agent

        </p>


        <!-- Status message -->

        <div class="message-box">

            <p id="message">

                Press Start Call to begin.

            </p>

        </div>


        <!-- Conversation -->

        <div id="transcriptContainer"
             class="conversation"
             hidden>

            <div class="bubble user">

                <strong>You</strong>

                <p id="userTranscript"></p>

            </div>

            <div class="bubble agent">

                <strong>Agent</strong>

                <p id="agentTranscript"></p>

            </div>

        </div>


        <!-- Button -->

        <button id="callButton"
                class="call-button"
                type="button">

            🎤 Start Call

        </button>


        <p class="privacy-note">

            Your microphone is only active during the call.

        </p>

    </div>

</div>

