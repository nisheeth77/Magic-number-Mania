from pathlib import Path

from fastapi import FastAPI, Request, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates


BASE_DIR = Path(__file__).resolve().parent

app = FastAPI(title="DU Voice Support Agent")

app.mount(
    "/static",
    StaticFiles(directory=BASE_DIR / "static"),
    name="static",
)

templates = Jinja2Templates(
    directory=BASE_DIR / "templates"
)


@app.get("/", response_class=HTMLResponse)
async def home(request: Request):
    return templates.TemplateResponse(
        request=request,
        name="index.html",
        context={},
    )


@app.get("/health")
async def health():
    return {"status": "healthy"}


@app.websocket("/ws/voice")
async def voice_websocket(websocket: WebSocket):
    await websocket.accept()

    print("Browser WebSocket connected")

    total_audio_bytes = 0
    chunk_count = 0

    try:
        await websocket.send_json(
            {
                "type": "status",
                "message": "Voice connection established",
            }
        )

        while True:
            message = await websocket.receive()

            if message.get("text") is not None:
                text = message["text"]
                print(f"Text received: {text}")

            elif message.get("bytes") is not None:
                audio_chunk = message["bytes"]

                chunk_count += 1
                total_audio_bytes += len(audio_chunk)

                print(
                    f"Audio chunk {chunk_count}: "
                    f"{len(audio_chunk)} bytes | "
                    f"Total: {total_audio_bytes} bytes"
                )

                if chunk_count % 10 == 0:
                    await websocket.send_json(
                        {
                            "type": "audio-status",
                            "message": (
                                f"Microphone active — "
                                f"{chunk_count} chunks received"
                            ),
                        }
                    )

    except WebSocketDisconnect:
        print("Browser WebSocket disconnected")
        print(f"Total chunks received: {chunk_count}")
        print(f"Total audio bytes: {total_audio_bytes}")

    except Exception as error:
        print(f"WebSocket error: {error}")










<script>
    const callButton =
        document.getElementById("callButton");

    const statusText =
        document.getElementById("connectionStatus");

    const statusDot =
        document.getElementById("statusDot");

    const message =
        document.getElementById("message");

    let socket = null;
    let mediaStream = null;
    let mediaRecorder = null;
    let callActive = false;


    callButton.addEventListener("click", async () => {
        if (callActive) {
            endCall();
        } else {
            await startCall();
        }
    });


    async function startCall() {
        try {
            callButton.disabled = true;
            statusText.textContent = "Requesting microphone...";
            message.textContent =
                "Please allow microphone access in your browser.";

            mediaStream =
                await navigator.mediaDevices.getUserMedia({
                    audio: true
                });

            const protocol =
                window.location.protocol === "https:"
                    ? "wss"
                    : "ws";

            const websocketUrl =
                `${protocol}://${window.location.host}/ws/voice`;

            socket = new WebSocket(websocketUrl);

            socket.binaryType = "arraybuffer";


            socket.onopen = () => {
                callActive = true;
                callButton.disabled = false;

                callButton.textContent = "End Call";
                callButton.classList.add("end-call");

                statusText.textContent = "Listening";

                statusDot.classList.remove(
                    "connecting",
                    "error"
                );

                statusDot.classList.add("connected");

                message.textContent =
                    "Microphone connected. Start speaking.";

                startMicrophoneStreaming();
            };


            socket.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);

                    console.log(
                        "Server message:",
                        data
                    );

                    if (
                        data.type === "status" ||
                        data.type === "audio-status"
                    ) {
                        message.textContent =
                            data.message;
                    }

                    if (data.type === "error") {
                        statusText.textContent = "Error";
                        message.textContent = data.message;
                    }

                } catch (error) {
                    console.error(
                        "Unable to read server message:",
                        error
                    );
                }
            };


            socket.onerror = (error) => {
                console.error(
                    "WebSocket error:",
                    error
                );

                statusText.textContent =
                    "Connection error";

                message.textContent =
                    "Unable to connect to the voice backend.";

                stopMicrophone();
                resetCallUI();
            };


            socket.onclose = () => {
                stopMicrophone();
                resetCallUI();
            };

        } catch (error) {
            console.error(
                "Microphone error:",
                error
            );

            callButton.disabled = false;

            statusText.textContent =
                "Microphone unavailable";

            statusDot.classList.add("error");

            if (error.name === "NotAllowedError") {
                message.textContent =
                    "Microphone permission was denied.";
            } else {
                message.textContent =
                    "Unable to access the microphone.";
            }
        }
    }


    function startMicrophoneStreaming() {
        let mimeType = "";

        const supportedTypes = [
            "audio/webm;codecs=opus",
            "audio/webm",
            "audio/ogg;codecs=opus"
        ];

        for (const type of supportedTypes) {
            if (MediaRecorder.isTypeSupported(type)) {
                mimeType = type;
                break;
            }
        }

        const options =
            mimeType ? { mimeType } : undefined;

        mediaRecorder =
            new MediaRecorder(mediaStream, options);

        console.log(
            "Recording format:",
            mediaRecorder.mimeType
        );

        mediaRecorder.ondataavailable = async (event) => {
            if (
                event.data.size > 0 &&
                socket &&
                socket.readyState === WebSocket.OPEN
            ) {
                const audioBuffer =
                    await event.data.arrayBuffer();

                socket.send(audioBuffer);
            }
        };

        mediaRecorder.onerror = (event) => {
            console.error(
                "MediaRecorder error:",
                event.error
            );
        };

        // Creates one audio chunk every 250 milliseconds.
        mediaRecorder.start(250);
    }


    function endCall() {
        stopMicrophone();

        if (
            socket &&
            socket.readyState === WebSocket.OPEN
        ) {
            socket.close();
        }

        socket = null;
        resetCallUI();
    }


    function stopMicrophone() {
        if (
            mediaRecorder &&
            mediaRecorder.state !== "inactive"
        ) {
            mediaRecorder.stop();
        }

        mediaRecorder = null;

        if (mediaStream) {
            mediaStream
                .getTracks()
                .forEach(track => track.stop());
        }

        mediaStream = null;
    }


    function resetCallUI() {
        callActive = false;

        callButton.disabled = false;
        callButton.textContent = "Start Call";
        callButton.classList.remove("end-call");

        statusText.textContent = "Ready";

        statusDot.classList.remove(
            "connecting",
            "connected",
            "error"
        );

        message.textContent =
            "Press Start Call to speak with the support agent.";
    }
</script>



