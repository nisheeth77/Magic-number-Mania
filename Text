<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DU Virtual Support</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', path='style.css') }}?v=5"
    >
</head>

<body>
    <div class="application-shell">

        <!-- Top header -->
        <header class="top-bar">
            <div class="agent-brand">
                <div class="brand-icon">du</div>

                <div>
                    <h2>DU Virtual Support</h2>
                    <p>Your AI-powered customer support agent</p>
                </div>
            </div>

            <div class="session-controls">
                <div class="technology-badge">
                    Azure AI Foundry
                </div>

                <div class="technology-badge">
                    Voice Live
                </div>

                <div class="connection-badge">
                    <span
                        id="statusDot"
                        class="status-dot"
                    ></span>

                    <span id="connectionStatus">
                        Ready
                    </span>
                </div>

                <button
                    id="callButton"
                    class="call-button"
                    type="button"
                >
                    Start Call
                </button>
            </div>
        </header>


        <!-- Main workspace -->
        <main class="workspace">

            <!-- Left panel -->
            <section class="information-panel">
                <div class="section-heading">
                    <span class="eyebrow">
                        LIVE CUSTOMER SESSION
                    </span>

                    <h1>How can we help you today?</h1>

                    <p>
                        Speak naturally with the DU support assistant.
                        Your conversation will appear here in real time.
                    </p>
                </div>


                <!-- Current system message -->
                <div class="live-status-card">
                    <div class="live-status-icon">
                        <span class="microphone-icon">🎙</span>
                    </div>

                    <div>
                        <span class="card-label">
                            Current status
                        </span>

                        <p id="message">
                            Press Start Call to speak with the support agent.
                        </p>
                    </div>
                </div>


                <!-- Transcript section -->
                <div
                    id="transcriptContainer"
                    class="conversation-panel"
                    hidden
                >
                    <div class="conversation-heading">
                        <h3>Live conversation</h3>

                        <span class="live-indicator">
                            Live
                        </span>
                    </div>

                    <div class="message-row user-row">
                        <div class="message-avatar user-avatar">
                            You
                        </div>

                        <div class="message-content">
                            <span class="speaker-name">
                                You
                            </span>

                            <div class="message-bubble user-bubble">
                                <span id="userTranscript"></span>
                            </div>
                        </div>
                    </div>

                    <div class="message-row agent-row">
                        <div class="message-avatar agent-message-avatar">
                            du
                        </div>

                        <div class="message-content">
                            <span class="speaker-name">
                                DU Assistant
                            </span>

                            <div class="message-bubble agent-bubble">
                                <span id="agentTranscript"></span>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Features -->
                <div class="feature-row">
                    <div class="feature-item">
                        <span>🌐</span>

                        <div>
                            <strong>Multilingual</strong>
                            <p>Speak in English or Hindi</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <span>⚡</span>

                        <div>
                            <strong>Real-time</strong>
                            <p>Streaming voice responses</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <span>🔒</span>

                        <div>
                            <strong>Secure</strong>
                            <p>Azure identity authentication</p>
                        </div>
                    </div>
                </div>
            </section>


            <!-- Right panel -->
            <section class="assistant-panel">

                <div class="assistant-background-circle"></div>

                <div class="assistant-visual">
                    <div class="avatar-glow"></div>

                    <div class="assistant-avatar">
                        <div class="avatar-head">
                            <div class="avatar-hair"></div>
                            <div class="avatar-face"></div>
                        </div>

                        <div class="avatar-body">
                            <div class="avatar-shirt"></div>
                            <div class="avatar-jacket left-jacket"></div>
                            <div class="avatar-jacket right-jacket"></div>
                        </div>
                    </div>
                </div>


                <div class="assistant-description">
                    <div class="assistant-name">
                        DU Virtual Assistant
                    </div>

                    <p>
                        Hello! I am your DU customer support assistant.
                        Start the call and tell me how I can help you.
                    </p>
                </div>


                <div class="audio-visualizer" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <p class="privacy-text">
                    Your microphone is only active during the call.
                </p>
            </section>
        </main>
    </div>


    <!-- Keep your complete existing JavaScript here without changing it. -->
    <script>
        /*
         * Paste your current JavaScript here exactly as it is.
         *
         * Do not rename:
         * callButton
         * connectionStatus
         * statusDot
         * message
         * transcriptContainer
         * userTranscript
         * agentTranscript
         */
    </script>
</body>
</html>
