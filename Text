* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(135deg, #f4f7fb, #e8edf5);
}

.app-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.agent-card {
    width: 100%;
    max-width: 440px;
    padding: 42px 32px;
    background: white;
    border-radius: 24px;
    text-align: center;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
}

.status-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 14px;
    color: #536173;
}

.status-dot {
    width: 10px;
    height: 10px;
    background: #25b46b;
    border-radius: 50%;
}

.avatar {
    width: 130px;
    height: 130px;
    margin: 0 auto 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #00a7ce, #164194);
    color: white;
    font-size: 36px;
    font-weight: bold;
    box-shadow: 0 10px 30px rgba(22, 65, 148, 0.25);
}

h1 {
    margin-bottom: 10px;
    color: #172033;
    font-size: 28px;
}

.subtitle {
    color: #68758a;
    line-height: 1.5;
}

.conversation {
    min-height: 90px;
    margin: 28px 0;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f6f8fb;
    border-radius: 16px;
    color: #4d596c;
    line-height: 1.5;
}

.call-button {
    width: 100%;
    padding: 16px;
    border: none;
    border-radius: 14px;
    background: #164194;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s, opacity 0.2s;
}

.call-button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
}

.call-button.end-call {
    background: #d93d4a;
}

.privacy-note {
    margin-top: 18px;
    color: #8b95a5;
    font-size: 12px;
}



