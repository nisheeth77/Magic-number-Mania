# ============================================================
# WebSocket proxy helpers
# ============================================================

async def forward_browser_to_azure(
    browser_ws: WebSocket,
    azure_ws: aiohttp.ClientWebSocketResponse,
) -> None:
    while True:
        browser_message = await browser_ws.receive()

        message_type = browser_message.get("type")

        if message_type == "websocket.disconnect":
            return

        text = browser_message.get("text")

        if text is not None:
            try:
                payload = json.loads(text)
            except json.JSONDecodeError:
                await browser_ws.send_json(
                    {
                        "type": "proxy.error",
                        "error": {
                            "message": "Invalid JSON sent by browser."
                        },
                    }
                )
                continue

            event_type = payload.get("type", "unknown")
            logger.info("Browser -> Azure: %s", event_type)

            await azure_ws.send_str(
                json.dumps(payload)
            )

        binary = browser_message.get("bytes")

        if binary is not None:
            await azure_ws.send_bytes(binary)


async def forward_azure_to_browser(
    azure_ws: aiohttp.ClientWebSocketResponse,
    browser_ws: WebSocket,
) -> None:
    async for azure_message in azure_ws:

        if azure_message.type == aiohttp.WSMsgType.TEXT:
            try:
                payload = json.loads(azure_message.data)
                event_type = payload.get("type", "unknown")

                logger.info("Azure -> Browser: %s", event_type)

                await browser_ws.send_json(payload)

            except json.JSONDecodeError:
                await browser_ws.send_text(
                    azure_message.data
                )

        elif azure_message.type == aiohttp.WSMsgType.BINARY:
            await browser_ws.send_bytes(
                azure_message.data
            )

        elif azure_message.type == aiohttp.WSMsgType.ERROR:
            error = azure_ws.exception()

            logger.error(
                "Azure WebSocket error: %s",
                error,
            )

            await browser_ws.send_json(
                {
                    "type": "proxy.error",
                    "error": {
                        "message": str(error)
                    },
                }
            )
            return

        elif azure_message.type in {
            aiohttp.WSMsgType.CLOSE,
            aiohttp.WSMsgType.CLOSED,
            aiohttp.WSMsgType.CLOSING,
        }:
            return


# ============================================================
# WebRTC signaling/control WebSocket
# ============================================================

@app.websocket("/ws/signaling")
async def signaling_websocket(
    browser_ws: WebSocket,
):
    await browser_ws.accept()

    azure_ws: Optional[
        aiohttp.ClientWebSocketResponse
    ] = None

    try:
        credential: AzureCliCredential = (
            browser_ws.app.state.azure_credential
        )

        http_session: aiohttp.ClientSession = (
            browser_ws.app.state.http_session
        )

        logger.info("Requesting Azure access token")

        access_token = await credential.get_token(
            AZURE_TOKEN_SCOPE
        )

        azure_control_url = build_azure_control_url()

        logger.info(
            "Opening Azure Voice Live WebRTC control channel"
        )

        azure_ws = await http_session.ws_connect(
            azure_control_url,
            headers={
                "Authorization": (
                    f"Bearer {access_token.token}"
                ),
            },
            protocols=["realtime"],
            heartbeat=30,
            max_msg_size=16 * 1024 * 1024,
        )

        await browser_ws.send_json(
            {
                "type": "proxy.connected",
                "message": (
                    "Secure Voice Live control channel connected."
                ),
            }
        )

        browser_to_azure_task = asyncio.create_task(
            forward_browser_to_azure(
                browser_ws,
                azure_ws,
            )
        )

        azure_to_browser_task = asyncio.create_task(
            forward_azure_to_browser(
                azure_ws,
                browser_ws,
            )
        )

        done, pending = await asyncio.wait(
            {
                browser_to_azure_task,
                azure_to_browser_task,
            },
            return_when=asyncio.FIRST_COMPLETED,
        )

        for task in pending:
            task.cancel()

        await asyncio.gather(
            *pending,
            return_exceptions=True,
        )

        for task in done:
            if task.cancelled():
                continue

            exception = task.exception()

            if exception:
                raise exception

    except WebSocketDisconnect:
        logger.info("Browser disconnected")

    except aiohttp.WSServerHandshakeError as exc:
        logger.exception(
            "Azure rejected the WebSocket handshake"
        )

        try:
            await browser_ws.send_json(
                {
                    "type": "proxy.error",
                    "error": {
                        "message": (
                            "Azure rejected the Voice Live "
                            f"connection with HTTP {exc.status}."
                        )
                    },
                }
            )
        except Exception:
            pass

    except Exception as exc:
        logger.exception(
            "Voice Live signaling session failed"
        )

        try:
            await browser_ws.send_json(
                {
                    "type": "proxy.error",
                    "error": {
                        "message": str(exc)
                    },
                }
            )
        except Exception:
            pass

    finally:
        if azure_ws is not None and not azure_ws.closed:
            await azure_ws.close()

        try:
            await browser_ws.close()
        except Exception:
            pass

        logger.info("Voice Live signaling session closed")


