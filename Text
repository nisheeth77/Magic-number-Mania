.assistant-visual {
    position: relative;
    z-index: 2;

    width: 360px;
    height: 420px;

    display: flex;
    align-items: center;
    justify-content: center;
}


.avatar-glow {
    position: absolute;

    width: 280px;
    height: 280px;

    border-radius: 50%;

    background: rgba(105, 56, 239, 0.22);

    filter: blur(55px);
}


.assistant-image-frame {
    position: relative;
    z-index: 2;

    width: 330px;
    height: 390px;

    display: flex;
    align-items: flex-end;
    justify-content: center;

    overflow: hidden;

    border: 1px solid rgba(105, 56, 239, 0.18);
    border-radius: 50% 50% 44% 44%;

    background:
        radial-gradient(
            circle at center,
            rgba(255, 255, 255, 1),
            rgba(236, 232, 250, 0.92)
        );

    box-shadow:
        0 24px 60px rgba(59, 43, 103, 0.18),
        inset 0 0 45px rgba(105, 56, 239, 0.07);
}


.assistant-image {
    position: relative;
    z-index: 2;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center bottom;

    user-select: none;
    pointer-events: none;
}


.speaking-ring {
    position: absolute;
    inset: 10px;

    z-index: 1;

    border: 2px solid rgba(105, 56, 239, 0.25);
    border-radius: 50% 50% 44% 44%;

    opacity: 0;
    transform: scale(0.96);

    transition:
        opacity 0.25s ease,
        transform 0.25s ease;
}


/* Add the speaking class from JavaScript later if required */
.assistant-image-frame.speaking .speaking-ring {
    opacity: 1;

    animation:
        speakingPulse 1.4s ease-in-out infinite;
}


.assistant-image-frame.speaking {
    box-shadow:
        0 24px 65px rgba(105, 56, 239, 0.28),
        0 0 0 8px rgba(105, 56, 239, 0.08),
        inset 0 0 45px rgba(105, 56, 239, 0.08);
}


@keyframes speakingPulse {
    0%,
    100% {
        opacity: 0.35;
        transform: scale(0.97);
    }

    50% {
        opacity: 1;
        transform: scale(1.02);
    }
}
