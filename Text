import asyncio
import json
import logging
import os
from contextlib import asynccontextmanager
from typing import Any

from azure.ai.voicelive.aio import connect
from azure.ai.voicelive.models import AgentSessionConfig
from azure.identity.aio import AzureCliCredential
from dotenv import load_dotenv
from fastapi import FastAPI, Request, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates


# ---------------------------------------------------------
# Environment configuration
# ---------------------------------------------------------

load_dotenv()

VOICE_LIVE_ENDPOINT = os.getenv("VOICELIVE_ENDPOINT", "").rstrip("/")
PROJECT_NAME = os.getenv("PROJECT_NAME", "")
AGENT_NAME = os.getenv("AGENT_NAME", "")
AGENT_VERSION = os.getenv("AGENT_VERSION", "")
VOICE_LIVE_API_VERSION = os.getenv(
    "VOICELIVE_API_VERSION",
    "2026-01-01-preview",
)

HOST = os.getenv("HOST", "127.0.0.1")
PORT = int(os.getenv("PORT", "8000"))


# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
)

logger = logging.getLogger("dubai-telco-avatar")


# ---------------------------------------------------------
# Validation
# ---------------------------------------------------------

def validate_environment() -> None:
    missing = []

    required_variables = {
        "VOICELIVE_ENDPOINT": VOICE_LIVE_ENDPOINT,
        "PROJECT_NAME": PROJECT_NAME,
        "AGENT_NAME": AGENT_NAME,
    }

    for variable_name, value in required_variables.items():
        if not value:
            missing.append(variable_name)

    if missing:
        raise RuntimeError(
            "Missing required environment variables: "
            + ", ".join(missing)
        )


# ---------------------------------------------------------
# Application lifecycle
# ---------------------------------------------------------

@asynccontextmanager
async def lifespan(app: FastAPI):
    validate_environment()

    credential = AzureCliCredential()
    app.state.azure_credential = credential

    logger.info("Application started")
    logger.info("Voice Live endpoint: %s", VOICE_LIVE_ENDPOINT)
    logger.info("Project: %s", PROJECT_NAME)
    logger.info("Agent: %s", AGENT_NAME)

    try:
        yield
    finally:
        await credential.close()
        logger.info("Azure credential closed")


app = FastAPI(
    title="Dubai Telco Avatar Voice Agent",
    version="1.0.0",
    lifespan=lifespan,
)


# ---------------------------------------------------------
# Static files and templates
# ---------------------------------------------------------

app.mount(
    "/static",
    StaticFiles(directory="static"),
    name="static",
)

templates = Jinja2Templates(directory="templates")


# ---------------------------------------------------------
# Basic routes
# ---------------------------------------------------------

@app.get("/", response_class=HTMLResponse)
async def home(request: Request):
    return templates.TemplateResponse(
        request=request,
        name="index.html",
        context={
            "voice_live_endpoint": VOICE_LIVE_ENDPOINT,
            "model": "",
            "api_version": VOICE_LIVE_API_VERSION,
        },
    )


@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "service": "Dubai Telco Avatar Voice Agent",
        "voice_live_configured": bool(VOICE_LIVE_ENDPOINT),
        "project_configured": bool(PROJECT_NAME),
        "agent_configured": bool(AGENT_NAME),
        "agent_version": AGENT_VERSION or "latest",
    }


# ---------------------------------------------------------
# Utility functions
# ---------------------------------------------------------

async def send_browser_event(
    browser_socket: WebSocket,
    event_type: str,
    **data: Any,
) -> None:
    """
    Send an application-level JSON event to the browser.
    """

    payload = {
        "type": event_type,
        **data,
    }

    await browser_socket.send_json(payload)


def create_agent_config() -> AgentSessionConfig:
    """
    Identify the existing Foundry Voice Live agent.

    The voice, avatar, instructions, VAD and knowledge configuration
    should already be stored in the agent configuration.
    """

    config_data: dict[str, Any] = {
        "project_name": PROJECT_NAME,
        "agent_name": AGENT_NAME,
    }

    if AGENT_VERSION:
        config_data["agent_version"] = AGENT_VERSION

    return AgentSessionConfig(**config_data)


def serialize_voice_live_event(event: Any) -> dict[str, Any]:
    """
    Convert an Azure SDK event into a JSON-compatible dictionary.
    """

    if isinstance(event, dict):
        return event

    if hasattr(event, "as_dict"):
        return event.as_dict()

    if hasattr(event, "model_dump"):
        return event.model_dump(
            mode="json",
            exclude_none=True,
        )

    if hasattr(event, "__dict__"):
        return {
            key: value
            for key, value in vars(event).items()
            if not key.startswith("_")
        }

    return {
        "type": "unknown",
        "value": str(event),
    }


async def send_event_to_voice_live(
    connection: Any,
    event: dict[str, Any],
) -> None:
    """
    Send a browser-generated Voice Live event to Azure.

    Different preview SDK builds expose either send() or
    send_event(), so both are supported here.
    """

    if hasattr(connection, "send"):
        await connection.send(event)
        return

    if hasattr(connection, "send_event"):
        await connection.send_event(event)
        return

    raise RuntimeError(
        "The installed azure-ai-voicelive package does not expose "
        "send() or send_event()."
    )


async def receive_voice_live_event(connection: Any) -> Any:
    """
    Receive one event from the Azure Voice Live connection.
    """

    if hasattr(connection, "recv"):
        return await connection.recv()

    if hasattr(connection, "receive"):
        return await connection.receive()

    raise RuntimeError(
        "The installed azure-ai-voicelive package does not expose "
        "recv() or receive()."
    )


# ---------------------------------------------------------
# Browser -> Azure
# ---------------------------------------------------------

async def browser_to_voice_live(
    browser_socket: WebSocket,
    voice_connection: Any,
) -> None:
    """
    Forward browser messages to Azure Voice Live.

    JSON is used for:
    - session events
    - SDP/WebRTC negotiation
    - transcript/control events

    Binary data is used for:
    - PCM microphone audio, when the architecture requires it
    """

    while True:
        browser_message = await browser_socket.receive()

        message_type = browser_message.get("type")

        if message_type == "websocket.disconnect":
            raise WebSocketDisconnect()

        text_data = browser_message.get("text")
        binary_data = browser_message.get("bytes")

        if text_data is not None:
            try:
                event = json.loads(text_data)
            except json.JSONDecodeError as exc:
                logger.warning(
                    "Invalid JSON received from browser: %s",
                    exc,
                )

                await send_browser_event(
                    browser_socket,
                    "application.error",
                    message="Invalid JSON event sent by the browser.",
                )
                continue

            event_type = event.get("type", "unknown")
            logger.debug("Browser -> Voice Live: %s", event_type)

            await send_event_to_voice_live(
                voice_connection,
                event,
            )

        elif binary_data is not None:
            # Retained for the WebSocket-audio architecture.
            # The next app.js version will normally send microphone
            # audio through the Voice Live WebRTC audio track.
            audio_event = {
                "type": "input_audio_buffer.append",
                "audio": binary_data,
            }

            await send_event_to_voice_live(
                voice_connection,
                audio_event,
            )


# ---------------------------------------------------------
# Azure -> Browser
# ---------------------------------------------------------

async def voice_live_to_browser(
    browser_socket: WebSocket,
    voice_connection: Any,
) -> None:
    """
    Forward Voice Live events to the browser.

    app.js will process events such as:
    - session.updated
    - session.avatar.connecting
    - session.avatar.connected
    - conversation.item.input_audio_transcription.*
    - response.audio_transcript.*
    - input_audio_buffer.speech_started
    - input_audio_buffer.speech_stopped
    - response.created
    - response.done
    - error
    """

    while True:
        azure_event = await receive_voice_live_event(
            voice_connection
        )

        if azure_event is None:
            logger.info("Voice Live connection returned no event")
            return

        event_payload = serialize_voice_live_event(azure_event)
        event_type = event_payload.get("type", "unknown")

        logger.debug("Voice Live -> Browser: %s", event_type)

        await browser_socket.send_text(
            json.dumps(
                event_payload,
                default=str,
            )
        )


# ---------------------------------------------------------
# Main WebSocket endpoint
# ---------------------------------------------------------

@app.websocket("/ws/voice")
async def voice_websocket(browser_socket: WebSocket):
    await browser_socket.accept()

    logger.info("Browser WebSocket connected")

    await send_browser_event(
        browser_socket,
        "application.connecting",
        message="Connecting to Azure Voice Live...",
    )

    credential: AzureCliCredential = (
        browser_socket.app.state.azure_credential
    )

    try:
        agent_config = create_agent_config()

        async with connect(
            endpoint=VOICE_LIVE_ENDPOINT,
            credential=credential,
            api_version=VOICE_LIVE_API_VERSION,
            agent_config=agent_config,
        ) as voice_connection:

            logger.info("Connected to Azure Voice Live")

            await send_browser_event(
                browser_socket,
                "application.connected",
                message="Connected to Azure Voice Live.",
            )

            browser_task = asyncio.create_task(
                browser_to_voice_live(
                    browser_socket,
                    voice_connection,
                )
            )

            azure_task = asyncio.create_task(
                voice_live_to_browser(
                    browser_socket,
                    voice_connection,
                )
            )

            done, pending = await asyncio.wait(
                {browser_task, azure_task},
                return_when=asyncio.FIRST_COMPLETED,
            )

            for task in pending:
                task.cancel()

            await asyncio.gather(
                *pending,
                return_exceptions=True,
            )

            for task in done:
                exception = task.exception()

                if exception:
                    raise exception

    except WebSocketDisconnect:
        logger.info("Browser disconnected")

    except asyncio.CancelledError:
        logger.info("Voice session cancelled")
        raise

    except Exception as exc:
        logger.exception("Voice session failed")

        try:
            await send_browser_event(
                browser_socket,
                "application.error",
                message=str(exc),
            )
        except Exception:
            pass

    finally:
        try:
            await browser_socket.close()
        except Exception:
            pass

        logger.info("Voice session closed")


