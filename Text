import asyncio
import os

from azure.identity.aio import AzureCliCredential
from dotenv import load_dotenv

from azure.ai.voicelive.aio import AgentSessionConfig, connect


load_dotenv()


async def test_connection() -> None:
    endpoint = os.getenv("VOICELIVE_ENDPOINT")
    project_name = os.getenv("PROJECT_NAME")
    agent_name = os.getenv("AGENT_NAME")
    agent_version = os.getenv("AGENT_VERSION")
    api_version = os.getenv("VOICELIVE_API_VERSION", "2026-04-10")

    required_values = {
        "VOICELIVE_ENDPOINT": endpoint,
        "PROJECT_NAME": project_name,
        "AGENT_NAME": agent_name,
    }

    missing = [
        name
        for name, value in required_values.items()
        if not value
    ]

    if missing:
        raise ValueError(
            f"Missing environment variables: {', '.join(missing)}"
        )

    credential = AzureCliCredential()

    agent_config = AgentSessionConfig(
        agent_name=agent_name,
        project_name=project_name,
        agent_version=agent_version or None,
    )

    try:
        print("Connecting to Voice Live...")
        print(f"Agent: {agent_name}")
        print(f"Project: {project_name}")
        print(f"Version: {agent_version or 'latest'}")

        async with connect(
            endpoint=endpoint,
            credential=credential,
            agent_config=agent_config,
            api_version=api_version,
        ):
            print("Successfully connected to the Foundry voice agent.")

    finally:
        await credential.close()


if __name__ == "__main__":
    asyncio.run(test_connection())
