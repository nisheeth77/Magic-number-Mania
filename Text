    )
};


// ============================================================
// General utilities
// ============================================================

function log(message, data = null) {
    const timestamp = new Date().toLocaleTimeString();

    if (data !== null) {
        console.log(`[${timestamp}] ${message}`, data);
    } else {
        console.log(`[${timestamp}] ${message}`);
    }
}

function setStatus(message, state = "idle") {
    if (elements.statusText) {
        elements.statusText.textContent = message;
    }

    if (elements.statusDot) {
        elements.statusDot.classList.remove(
            "connected",
            "connecting",
            "error",
            "listening",
            "speaking",
            "disconnected"
        );

        elements.statusDot.classList.add(state);
    }
}

function setButtonState(active) {
    if (elements.startButton) {
        elements.startButton.disabled = active;
    }

    if (elements.endButton) {
        elements.endButton.disabled = !active;
    }

    if (elements.muteButton) {
        elements.muteButton.disabled = !active;
    }
}

function setListening(isListening) {
    if (elements.listeningIndicator) {
        elements.listeningIndicator.hidden = !isListening;
        elements.listeningIndicator.classList.toggle(
            "active",
            isListening
        );
    }

    if (isListening) {
        setStatus("Listening…", "listening");
    }
}

function setSpeaking(isSpeaking) {
    if (elements.speakingIndicator) {
        elements.speakingIndicator.hidden = !isSpeaking;
        elements.speakingIndicator.classList.toggle(
            "active",
            isSpeaking
        );
    }

    if (isSpeaking) {
        setStatus("Assistant speaking…", "speaking");
    }
}

function getWebSocketUrl(path) {
    const protocol =
        window.location.protocol === "https:"
            ? "wss:"
            : "ws:";

    return `${protocol}//${window.location.host}${path}`;
}

function wait(milliseconds) {
    return new Promise((resolve) => {
        setTimeout(resolve, milliseconds);
    });
}

function waitForIceGatheringComplete(
    connection,
    timeoutMilliseconds = 5000
) {
    if (connection.iceGatheringState === "complete") {
        return Promise.resolve();
    }

    return new Promise((resolve) => {
        let finished = false;

        const complete = () => {
            if (finished) {
                return;
            }

            finished = true;

            connection.removeEventListener(
                "icegatheringstatechange",
                stateChanged
            );

            resolve();
        };

        const stateChanged = () => {
            if (
                connection.iceGatheringState ===
                "complete"
            ) {
                complete();
            }
        };

        connection.addEventListener(
            "icegatheringstatechange",
            stateChanged
        );

        setTimeout(complete, timeoutMilliseconds);
    });
}


// ============================================================
// Configuration
// ============================================================

async function loadConfiguration() {
    const response = await fetch("/config", {
        method: "GET",
        headers: {
            Accept: "application/json"
        },
        cache: "no-store"
    });

    if (!response.ok) {
        throw new Error(
            `Unable to load configuration: HTTP ${response.status}`
        );
    }

    const config = await response.json();

    if (!config.signalingUrl) {
        throw new Error(
            "signalingUrl is missing from /config."
        );
    }

    return config;
}


// ============================================================
// Call timer
// ============================================================

function startTimer() {
    stopTimer();

    callStartedAt = Date.now();

    updateTimer();

    timerInterval = window.setInterval(
        updateTimer,
        1000
    );
}

function updateTimer() {
    if (!callStartedAt || !elements.timer) {
        return;
    }

    const elapsedSeconds = Math.floor(
        (Date.now() - callStartedAt) / 1000
    );

    const minutes = Math.floor(elapsedSeconds / 60);
    const seconds = elapsedSeconds % 60;

    elements.timer.textContent =
        `${String(minutes).padStart(2, "0")}:` +
        `${String(seconds).padStart(2, "0")}`;
}

function stopTimer() {
    if (timerInterval !== null) {
        window.clearInterval(timerInterval);
        timerInterval = null;
    }

    callStartedAt = null;

    if (elements.timer) {
        elements.timer.textContent = "00:00";
    }
}


// ============================================================
// Transcript UI
// ============================================================

function scrollTranscriptToBottom() {
    if (!elements.transcriptContainer) {
        return;
    }

    elements.transcriptContainer.scrollTop =
        elements.transcriptContainer.scrollHeight;
}

function createTranscriptBubble(role, text) {
    if (!elements.transcriptContainer || !text) {
        return null;
    }

    const bubble = document.createElement("div");

    bubble.className =
        role === "user"
            ? "transcript-message user-message"
            : "transcript-message agent-message";

    bubble.dataset.role = role;

    const label = document.createElement("div");
    label.className = "transcript-speaker";
    label.textContent =
        role === "user" ? "You" : "Assistant";

    const body = document.createElement("div");
    body.className = "transcript-text";
    body.textContent = text;

    bubble.appendChild(label);
    bubble.appendChild(body);

    elements.transcriptContainer.appendChild(bubble);

    scrollTranscriptToBottom();

    return bubble;
}

function updateLiveTranscript(role, text) {
    if (!text) {
        return;
    }

    const directElement =
        role === "user"
            ? elements.userTranscript
            : elements.assistantTranscript;

    if (directElement) {
        directElement.textContent = text;
        return;
    }

    if (!elements.transcriptContainer) {
        return;
    }

    const selector =
        role === "user"
            ? '[data-live-role="user"]'
            : '[data-live-role="assistant"]';

    let bubble =
        elements.transcriptContainer.querySelector(selector);

    if (!bubble) {
        bubble = createTranscriptBubble(role, text);

        if (bubble) {
            bubble.dataset.liveRole = role;
        }
    } else {
        const textElement =
            bubble.querySelector(".transcript-text");

        if (textElement) {
            textElement.textContent = text;
        }
    }

    scrollTranscriptToBottom();
}

function finalizeTranscript(role, text) {
    if (!text) {
        return;
    }

    const directElement =
        role === "user"
            ? elements.userTranscript
            : elements.assistantTranscript;

    if (directElement) {
        directElement.textContent = text;
    }

    if (elements.transcriptContainer) {
        const selector =
            role === "user"
                ? '[data-live-role="user"]'
                : '[data-live-role="assistant"]';

        const liveBubble =
            elements.transcriptContainer.querySelector(
                selector
            );

        if (liveBubble) {
            const textElement =
                liveBubble.querySelector(
                    ".transcript-text"
                );

            if (textElement) {
                textElement.textContent = text;
            }

            delete liveBubble.dataset.liveRole;
        } else if (!directElement) {
            createTranscriptBubble(role, text);
        }
    }

    scrollTranscriptToBottom();
}

function clearTranscripts() {
    currentUserTranscript = "";
    currentAssistantTranscript = "";

    if (elements.userTranscript) {
        elements.userTranscript.textContent = "";
    }

    if (elements.assistantTranscript) {
        elements.assistantTranscript.textContent = "";
    }

    if (elements.transcriptContainer) {
        const messages =
            elements.transcriptContainer.querySelectorAll(
                ".transcript-message"
            );

        messages.forEach((message) => {
            message.remove();
        });
    }
}


// ============================================================
// WebRTC media
// ============================================================

async function createPeerConnection() {
    remoteStream = new MediaStream();

    peerConnection = new RTCPeerConnection({
        bundlePolicy: "max-bundle"
    });

    peerConnection.onconnectionstatechange = () => {
        if (!peerConnection) {
            return;
        }

        const state = peerConnection.connectionState;

        log(`WebRTC connection state: ${state}`);

        if (state === "connected") {
            isCallActive = true;
            setButtonState(true);
            setStatus("Connected — you can speak", "connected");

            if (!timerInterval) {
                startTimer();
            }
        }

        if (
            state === "failed" ||
            state === "closed"
        ) {
            if (!isEndingCall) {
                handleConnectionFailure(
                    `WebRTC connection ${state}.`
                );
            }
        }

        if (state === "disconnected") {
            setStatus(
                "Connection interrupted…",
                "connecting"
            );
        }
    };

    peerConnection.oniceconnectionstatechange = () => {
        if (!peerConnection) {
            return;
        }

        log(
            `ICE connection state: ` +
            peerConnection.iceConnectionState
        );
    };

    peerConnection.onicecandidateerror = (event) => {
        log("ICE candidate error", event);
    };

    peerConnection.ontrack = async (event) => {
        log(
            `Remote ${event.track.kind} track received`
        );

        remoteStream.addTrack(event.track);

        if (elements.video) {
            if (
                elements.video.srcObject !==
                remoteStream
            ) {
                elements.video.srcObject =
                    remoteStream;
            }

            elements.video.autoplay = true;
            elements.video.playsInline = true;

            try {
                await elements.video.play();
            } catch (error) {
                log(
                    "Browser delayed media autoplay",
                    error
                );
            }
        }

        if (elements.avatarPlaceholder) {
            elements.avatarPlaceholder.hidden = true;
        }
    };

    localStream =
        await navigator.mediaDevices.getUserMedia({
            audio: {
                channelCount: 1,
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true
            },
            video: false
        });

    const microphoneTrack =
        localStream.getAudioTracks()[0];

    if (!microphoneTrack) {
        throw new Error(
            "No microphone audio track was found."
        );
    }

    peerConnection.addTrack(
        microphoneTrack,
        localStream
    );

    /*
     * The avatar video is returned as a remote WebRTC
     * video track, so we explicitly request a video
     * receiver.
     */
    peerConnection.addTransceiver("video", {
        direction: "recvonly"
    });

    createDataChannel();

    log("Microphone and WebRTC peer created");
}


// ============================================================
// Data channel
// ============================================================

function createDataChannel() {
    if (!peerConnection) {
        throw new Error(
            "Peer connection has not been created."
        );
    }

    dataChannel =
        peerConnection.createDataChannel(
            "voice-live-events"
        );

    dataChannel.onopen = () => {
        log("Voice Live data channel opened");
    };

    dataChannel.onclose = () => {
        log("Voice Live data channel closed");
    };

    dataChannel.onerror = (event) => {
        log("Data channel error", event);
    };

    dataChannel.onmessage = (event) => {
        try {
            const message = JSON.parse(event.data);
            handleVoiceLiveEvent(message, "data-channel");
        } catch (error) {
            log(
                "Unable to parse data-channel event",
                error
            );
        }
    };
}


// ============================================================
// Signaling WebSocket
// ============================================================

function openSignalingSocket(url) {
    return new Promise((resolve, reject) => {
        const socketUrl = getWebSocketUrl(url);

        log(`Opening signaling socket: ${socketUrl}`);

        signalingSocket = new WebSocket(socketUrl);

        let completed = false;

        const timeoutId = window.setTimeout(() => {
            if (completed) {
                return;
            }

            completed = true;

            reject(
                new Error(
                    "Timed out while connecting to the backend."
                )
            );
        }, 15000);

        signalingSocket.onopen = () => {
            log("Backend signaling socket opened");
        };

        signalingSocket.onmessage = (event) => {
            let message;

            try {
                message = JSON.parse(event.data);
            } catch (error) {
                log(
                    "Received non-JSON signaling message",
                    event.data
                );
                return;
            }

            handleVoiceLiveEvent(
                message,
                "signaling"
            );

            if (
                !completed &&
                message.type === "proxy.connected"
            ) {
                completed = true;
                window.clearTimeout(timeoutId);
                resolve();
            }
        };

        signalingSocket.onerror = () => {
            if (!completed) {
                completed = true;
                window.clearTimeout(timeoutId);

                reject(
                    new Error(
                        "Backend signaling connection failed."
                    )
                );
            }
        };

        signalingSocket.onclose = (event) => {
            log(
                `Signaling socket closed: ${event.code}`
            );

            if (!completed) {
                completed = true;
                window.clearTimeout(timeoutId);

                reject(
                    new Error(
                        "Signaling socket closed before connecting."
                    )
                );
            }
        };
    });
}

function waitForSdpAnswer(timeoutMilliseconds = 30000) {
    return new Promise((resolve, reject) => {
        const timeoutId = window.setTimeout(() => {
            cleanup();

            reject(
                new Error(
                    "Timed out waiting for Azure SDP answer."
                )
            );
        }, timeoutMilliseconds);

        const messageHandler = (event) => {
            let message;

            try {
                message = JSON.parse(event.data);
            } catch {
                return;
            }

            if (
                message.type ===
                "rtc.call.sdp.created"
            ) {
                cleanup();
                resolve(message);
                return;
            }

            if (
                message.type === "rtc.call.error" ||
                message.type === "proxy.error" ||
                message.type === "error"
            ) {
                cleanup();

                const errorMessage =
                    message.error?.message ||
                    message.message ||
                    "Voice Live signaling failed.";

                reject(new Error(errorMessage));
            }
        };

        const closeHandler = () => {
            cleanup();

            reject(
                new Error(
                    "Signaling socket closed before SDP negotiation completed."
                )
            );
        };

        function cleanup() {
            window.clearTimeout(timeoutId);

            if (signalingSocket) {
                signalingSocket.removeEventListener(
                    "message",
                    messageHandler
                );

                signalingSocket.removeEventListener(
                    "close",
                    closeHandler
                );
            }
        }

        signalingSocket.addEventListener(
            "message",
            messageHandler
        );

        signalingSocket.addEventListener(
            "close",
            closeHandler
        );
    });
}


// ============================================================
// Voice Live event processing
// ============================================================

function handleVoiceLiveEvent(message, source) {
    if (!message || !message.type) {
        return;
    }

    log(`${source}: ${message.type}`);

    switch (message.type) {
        case "proxy.connected":
            setStatus(
                "Secure connection established…",
                "connecting"
            );
            break;

        case "session.created":
        case "session.updated":
            log("Voice Live session ready");
            break;

        case "input_audio_buffer.speech_started":
            currentUserTranscript = "";
            setSpeaking(false);
            setListening(true);
            break;

        case "input_audio_buffer.speech_stopped":
            setListening(false);
            setStatus(
                "Processing your request…",
                "connecting"
            );
            break;

        case "conversation.item.input_audio_transcription.delta":
            currentUserTranscript +=
                message.delta || "";

            updateLiveTranscript(
                "user",
                currentUserTranscript
            );
            break;

        case "conversation.item.input_audio_transcription.completed":
            currentUserTranscript =
                message.transcript ||
                currentUserTranscript;

            finalizeTranscript(
                "user",
                currentUserTranscript
            );

            currentUserTranscript = "";
            break;

        case "response.created":
            currentAssistantTranscript = "";
            setStatus(
                "Assistant is thinking…",
                "connecting"
            );
            break;

        case "response.audio_transcript.delta":
            currentAssistantTranscript +=
                message.delta || "";

            updateLiveTranscript(
                "assistant",
                currentAssistantTranscript
            );

            setSpeaking(true);
            break;

        case "response.audio_transcript.done":
            currentAssistantTranscript =
                message.transcript ||
                currentAssistantTranscript;

            finalizeTranscript(
                "assistant",
                currentAssistantTranscript
            );

            currentAssistantTranscript = "";
            break;

        case "response.audio.done":
            setSpeaking(false);
            setStatus(
                "Connected — you can speak",
                "connected"
            );
            break;

        case "response.done":
            setSpeaking(false);
            setStatus(
                "Connected — you can speak",
                "connected"
            );
            break;

        case "warning":
            log(
                message.warning?.message ||
                "Voice Live warning",
                message
            );
            break;

        case "rtc.call.error":
        case "proxy.error":
        case "error": {
            const errorMessage =
                message.error?.message ||
                message.message ||
                "Voice Live returned an error.";

            showError(errorMessage);
            break;
        }

        default:
            break;
    }
}


// ============================================================
// Start call
// ============================================================

async function startCall() {
    if (isCallActive || peerConnection) {
        return;
    }

    isEndingCall = false;

    try {
        setButtonState(false);
        setStatus("Preparing call…", "connecting");

        if (!appConfig) {
            appConfig = await loadConfiguration();
            log("Frontend configuration loaded", appConfig);
        }

        await createPeerConnection();

        const offer =
            await peerConnection.createOffer();

        await peerConnection.setLocalDescription(
            offer
        );

        await waitForIceGatheringComplete(
            peerConnection
        );

        await openSignalingSocket(
            appConfig.signalingUrl
        );

        const avatar =
            appConfig.avatar || {};

        const request = {
            type: "rtc.call.sdp.create",

            sdp_offer:
                peerConnection.localDescription.sdp,

            session: {
                modalities: ["text", "audio"],

                avatar: {
                    type: "video-avatar",

                    character:
                        avatar.character || "lisa",

                    style:
                        avatar.style ||
                        "casual-sitting",

                    customized:
                        avatar.customized ?? false,

                    output_protocol: "webrtc",

                    video: {
                        resolution: {
                            width: 1280,
                            height: 720
                        },

                        bitrate: 2000000,

                        codec: "h264"
                    }
                }
            }
        };

        const sdpAnswerPromise =
            waitForSdpAnswer();

        signalingSocket.send(
            JSON.stringify(request)
        );

        log(
            "Sent rtc.call.sdp.create with avatar configuration"
        );

        const answer =
            await sdpAnswerPromise;

        if (!answer.sdp_answer) {
            throw new Error(
                "Azure response did not contain sdp_answer."
            );
        }

        await peerConnection.setRemoteDescription({
            type: "answer",
            sdp: answer.sdp_answer
        });

        log("Remote SDP answer applied");

        /*
         * The connectionstatechange handler will mark
         * the call as connected.
         */
        setStatus(
            "Connecting media…",
            "connecting"
        );
    } catch (error) {
        console.error(error);

        showError(
            error instanceof Error
                ? error.message
                : String(error)
        );

        await endCall(false);
    }
}


// ============================================================
// Mute and interruption
// ============================================================

function toggleMute() {
    if (!localStream) {
        return;
    }

    isMuted = !isMuted;

    localStream.getAudioTracks().forEach(
        (track) => {
            track.enabled = !isMuted;
        }
    );

    if (elements.muteButton) {
        elements.muteButton.classList.toggle(
            "muted",
            isMuted
        );

        const label =
            elements.muteButton.querySelector(
                ".button-label"
            );

        if (label) {
            label.textContent =
                isMuted ? "Unmute" : "Mute";
        } else {
            elements.muteButton.setAttribute(
                "aria-label",
                isMuted ? "Unmute" : "Mute"
            );
        }
    }

    setStatus(
        isMuted
            ? "Microphone muted"
            : "Connected — you can speak",
        isMuted ? "disconnected" : "connected"
    );
}

function interruptAssistant() {
    if (
        dataChannel &&
        dataChannel.readyState === "open"
    ) {
        dataChannel.send(
            JSON.stringify({
                type: "output_audio_buffer.clear"
            })
        );
    }
}


// ============================================================
// End call and cleanup
// ============================================================

async function endCall(
    updateStatus = true
) {
    if (isEndingCall) {
        return;
    }

    isEndingCall = true;
    isCallActive = false;

    stopTimer();
    setListening(false);
    setSpeaking(false);

    if (dataChannel) {
        try {
            dataChannel.close();
        } catch {
            // Ignore cleanup errors.
        }

        dataChannel = null;
    }

    if (localStream) {
        localStream.getTracks().forEach(
            (track) => track.stop()
        );

        localStream = null;
    }

    if (peerConnection) {
        try {
            peerConnection.ontrack = null;
            peerConnection.close();
        } catch {
            // Ignore cleanup errors.
        }

        peerConnection = null;
    }

    if (signalingSocket) {
        try {
            signalingSocket.close();
        } catch {
            // Ignore cleanup errors.
        }

        signalingSocket = null;
    }

    if (remoteStream) {
        remoteStream.getTracks().forEach(
            (track) => track.stop()
        );

        remoteStream = null;
    }

    if (elements.video) {
        elements.video.pause();
        elements.video.srcObject = null;
    }

    if (elements.avatarPlaceholder) {
        elements.avatarPlaceholder.hidden = false;
    }

    isMuted = false;

    setButtonState(false);

    if (updateStatus) {
        setStatus("Call ended", "disconnected");
    }

    log("Call resources cleaned up");

    await wait(100);

    isEndingCall = false;
}

async function handleConnectionFailure(message) {
    showError(message);
    await endCall(false);
}

function showError(message) {
    console.error(message);
    setStatus(`Error: ${message}`, "error");
}


// ============================================================
// Page initialization
// ============================================================

async function initializeApplication() {
    setButtonState(false);
    setStatus("Ready to start", "disconnected");
    stopTimer();

    try {
        appConfig = await loadConfiguration();
        log("Configuration loaded", appConfig);

        if (elements.startButton) {
            elements.startButton.disabled = false;
        }
    } catch (error) {
        showError(
            error instanceof Error
                ? error.message
                : String(error)
        );
    }

    if (elements.startButton) {
        elements.startButton.addEventListener(
            "click",
            startCall
        );
    }

    if (elements.endButton) {
        elements.endButton.addEventListener(
            "click",
            () => endCall(true)
        );
    }

    if (elements.muteButton) {
        elements.muteButton.addEventListener(
            "click",
            toggleMute
        );
    }

    window.addEventListener(
        "beforeunload",
        () => {
            if (signalingSocket) {
                signalingSocket.close();
            }

            if (peerConnection) {
                peerConnection.close();
            }

            if (localStream) {
                localStream
                    .getTracks()
                    .forEach(
                        (track) => track.stop()
                    );
            }
        }
    );
}

document.addEventListener(
    "DOMContentLoaded",
    initializeApplication
);



                                    




