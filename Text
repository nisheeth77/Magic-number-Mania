from agent_framework import Executor
from agent_framework_copilotstudio import CopilotStudioAgent


class HRExecutor(Executor):

    def __init__(self):
        super().__init__(id="hr")

        self.agent = CopilotStudioAgent(
            environment_id="YOUR_ENVIRONMENT_ID",
            agent_identifier="YOUR_AGENT_IDENTIFIER",
            client_id="YOUR_CLIENT_ID",
            tenant_id="YOUR_TENANT_ID",
        )

    async def execute(self, message, context):

        print("Calling HR Copilot Studio Agent...")

        response = await self.agent.run(message)

        print("HR Agent Response:")
        print(response)

        await context.yield_output(response)
