<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DU Virtual Support</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', path='/style.css') }}"
    >
</head>

<body>
    <main class="support-card">
        <div class="status-container">
            <span
                id="statusDot"
                class="status-dot"
            ></span>

            <span id="connectionStatus">
                Ready
            </span>
        </div>

        <div class="logo">
            DU
        </div>

        <h1>DU Virtual Support</h1>

        <p class="subtitle">
            Your AI-powered customer support assistant
        </p>

        <p
            id="message"
            class="message"
        >
            Press Start Call to speak with the support agent.
        </p>

        <div
            id="transcriptContainer"
            class="transcript-container"
            hidden
        >
            <p>
                <strong>You:</strong>
                <span id="userTranscript"></span>
            </p>

            <p>
                <strong>Agent:</strong>
                <span id="agentTranscript"></span>
            </p>
        </div>

        <button
            id="callButton"
            type="button"
        >
            Start Call
        </button>

        <p class="privacy-text">
            Your microphone will only be used during the active call.
        </p>
    </main>

    <script>
        const TARGET_SAMPLE_RATE = 24000;

        const callButton =
            document.getElementById("callButton");

        const connectionStatus =
            document.getElementById("connectionStatus");

        const statusDot =
            document.getElementById("statusDot");

        const messageText =
            document.getElementById("message");

        const transcriptContainer =
            document.getElementById("transcriptContainer");

        const userTranscript =
            document.getElementById("userTranscript");

        const agentTranscript =
            document.getElementById("agentTranscript");


        let socket = null;
        let microphoneStream = null;

        let inputAudioContext = null;
        let inputSource = null;
        let inputProcessor = null;

        let outputAudioContext = null;
        let nextPlaybackTime = 0;
        let activeAudioSources = [];

        let callActive = false;


        callButton.addEventListener(
            "click",
            async () => {
                if (callActive) {
                    await endCall();
                } else {
                    await startCall();
                }
            }
        );


        async function startCall() {
            try {
                callButton.disabled = true;

                setStatus(
                    "connecting",
                    "Requesting microphone access..."
                );

                microphoneStream =
                    await navigator.mediaDevices.getUserMedia({
                        audio: {
                            channelCount: 1,
                            echoCancellation: true,
                            noiseSuppression: true,
                            autoGainControl: true
                        }
                    });

                outputAudioContext = new AudioContext({
                    sampleRate: TARGET_SAMPLE_RATE
                });

                await outputAudioContext.resume();

                const websocketProtocol =
                    window.location.protocol === "https:"
                        ? "wss"
                        : "ws";

                socket = new WebSocket(
                    `${websocketProtocol}://` +
                    `${window.location.host}/ws/voice`
                );

                socket.binaryType = "arraybuffer";


                socket.onopen = async () => {
                    callActive = true;
                    callButton.disabled = false;
                    callButton.textContent = "End Call";
                    callButton.classList.add("end-call");

                    setStatus(
                        "connecting",
                        "Connecting to DU Voice Agent..."
                    );

                    await startMicrophoneCapture();
                };


                socket.onmessage = async event => {
                    if (typeof event.data === "string") {
                        handleServerMessage(event.data);
                        return;
                    }

                    if (event.data instanceof ArrayBuffer) {
                        playPcm16Audio(event.data);
                        return;
                    }

                    if (event.data instanceof Blob) {
                        const audioBuffer =
                            await event.data.arrayBuffer();

                        playPcm16Audio(audioBuffer);
                    }
                };


                socket.onerror = error => {
                    console.error(
                        "WebSocket error:",
                        error
                    );

                    setStatus(
                        "error",
                        "Unable to connect to the voice service."
                    );
                };


                socket.onclose = async () => {
                    await cleanupAudio();
                    resetCallUI();
                };

            } catch (error) {
                console.error(
                    "Unable to start call:",
                    error
                );

                await cleanupAudio();

                setStatus(
                    "error",
                    error.message ||
                    "Unable to access the microphone."
                );

                callButton.disabled = false;
            }
        }


        async function startMicrophoneCapture() {
            inputAudioContext = new AudioContext();

            await inputAudioContext.resume();

            inputSource =
                inputAudioContext.createMediaStreamSource(
                    microphoneStream
                );

            /*
             * ScriptProcessor is used here because it is easy to run
             * directly in a single HTML file. It captures raw samples,
             * which are then resampled and converted to PCM16.
             */
            inputProcessor =
                inputAudioContext.createScriptProcessor(
                    4096,
                    1,
                    1
                );

            inputProcessor.onaudioprocess = event => {
                if (
                    !socket ||
                    socket.readyState !== WebSocket.OPEN
                ) {
                    return;
                }

                const inputSamples =
                    event.inputBuffer
                        .getChannelData(0);

                const resampledSamples =
                    resampleAudio(
                        inputSamples,
                        inputAudioContext.sampleRate,
                        TARGET_SAMPLE_RATE
                    );

                const pcm16Buffer =
                    float32ToPcm16(
                        resampledSamples
                    );

                socket.send(pcm16Buffer);
            };

            inputSource.connect(inputProcessor);

            /*
             * Connecting to destination keeps ScriptProcessor active.
             * Output is silent because we don't copy microphone samples
             * into the output buffer.
             */
            inputProcessor.connect(
                inputAudioContext.destination
            );

            console.log(
                "Microphone sample rate:",
                inputAudioContext.sampleRate
            );
        }


        function resampleAudio(
            inputSamples,
            sourceSampleRate,
            targetSampleRate
        ) {
            if (sourceSampleRate === targetSampleRate) {
                return new Float32Array(inputSamples);
            }

            const sampleRateRatio =
                sourceSampleRate / targetSampleRate;

            const outputLength =
                Math.round(
                    inputSamples.length /
                    sampleRateRatio
                );

            const output =
                new Float32Array(outputLength);

            for (
                let outputIndex = 0;
                outputIndex < outputLength;
                outputIndex++
            ) {
                const sourcePosition =
                    outputIndex * sampleRateRatio;

                const lowerIndex =
                    Math.floor(sourcePosition);

                const upperIndex =
                    Math.min(
                        lowerIndex + 1,
                        inputSamples.length - 1
                    );

                const interpolation =
                    sourcePosition - lowerIndex;

                output[outputIndex] =
                    inputSamples[lowerIndex] *
                    (1 - interpolation) +
                    inputSamples[upperIndex] *
                    interpolation;
            }

            return output;
        }


        function float32ToPcm16(floatSamples) {
            const pcmBuffer =
                new ArrayBuffer(
                    floatSamples.length * 2
                );

            const dataView =
                new DataView(pcmBuffer);

            for (
                let index = 0;
                index < floatSamples.length;
                index++
            ) {
                const sample =
                    Math.max(
                        -1,
                        Math.min(
                            1,
                            floatSamples[index]
                        )
                    );

                const pcmValue =
                    sample < 0
                        ? sample * 0x8000
                        : sample * 0x7fff;

                dataView.setInt16(
                    index * 2,
                    pcmValue,
                    true
                );
            }

            return pcmBuffer;
        }


        function playPcm16Audio(arrayBuffer) {
            if (!outputAudioContext) {
                return;
            }

            const pcmData =
                new Int16Array(arrayBuffer);

            const floatData =
                new Float32Array(pcmData.length);

            for (
                let index = 0;
                index < pcmData.length;
                index++
            ) {
                floatData[index] =
                    pcmData[index] / 32768;
            }

            const audioBuffer =
                outputAudioContext.createBuffer(
                    1,
                    floatData.length,
                    TARGET_SAMPLE_RATE
                );

            audioBuffer
                .getChannelData(0)
                .set(floatData);

            const audioSource =
                outputAudioContext.createBufferSource();

            audioSource.buffer = audioBuffer;

            audioSource.connect(
                outputAudioContext.destination
            );

            const currentTime =
                outputAudioContext.currentTime;

            if (nextPlaybackTime < currentTime) {
                nextPlaybackTime = currentTime;
            }

            audioSource.start(nextPlaybackTime);

            nextPlaybackTime +=
                audioBuffer.duration;

            activeAudioSources.push(audioSource);

            audioSource.onended = () => {
                activeAudioSources =
                    activeAudioSources.filter(
                        source => source !== audioSource
                    );
            };
        }


        function clearAgentAudio() {
            for (const source of activeAudioSources) {
                try {
                    source.stop();
                } catch {
                    // Audio source may already be stopped.
                }
            }

            activeAudioSources = [];

            if (outputAudioContext) {
                nextPlaybackTime =
                    outputAudioContext.currentTime;
            }
        }


        function handleServerMessage(rawMessage) {
            let data;

            try {
                data = JSON.parse(rawMessage);
            } catch (error) {
                console.error(
                    "Invalid server message:",
                    rawMessage,
                    error
                );

                return;
            }

            console.log(
                "Server event:",
                data
            );

            switch (data.type) {
                case "connecting":
                    setStatus(
                        "connecting",
                        data.message
                    );
                    break;

                case "ready":
                    setStatus(
                        "connected",
                        data.message
                    );
                    break;

                case "listening":
                    setStatus(
                        "connected",
                        data.message
                    );
                    break;

                case "processing":
                    setStatus(
                        "connecting",
                        data.message
                    );
                    break;

                case "speaking":
                    setStatus(
                        "connected",
                        data.message
                    );
                    break;

                case "clear-audio":
                    clearAgentAudio();
                    break;

                case "user-transcript":
                    transcriptContainer.hidden = false;
                    userTranscript.textContent =
                        data.text;
                    break;

                case "agent-transcript":
                    transcriptContainer.hidden = false;
                    agentTranscript.textContent =
                        data.text;
                    break;

                case "error":
                    setStatus(
                        "error",
                        data.message ||
                        "Voice service error"
                    );
                    break;
            }
        }


        function setStatus(state, text) {
            connectionStatus.textContent =
                state === "connected"
                    ? "Listening"
                    : state === "error"
                        ? "Error"
                        : "Connecting";

            messageText.textContent = text;

            statusDot.classList.remove(
                "connected",
                "connecting",
                "error"
            );

            statusDot.classList.add(state);
        }


        async function endCall() {
            if (
                socket &&
                socket.readyState === WebSocket.OPEN
            ) {
                socket.close();
            }

            socket = null;

            await cleanupAudio();

            resetCallUI();
        }


        async function cleanupAudio() {
            clearAgentAudio();

            if (inputProcessor) {
                inputProcessor.disconnect();
                inputProcessor.onaudioprocess = null;
                inputProcessor = null;
            }

            if (inputSource) {
                inputSource.disconnect();
                inputSource = null;
            }

            if (microphoneStream) {
                microphoneStream
                    .getTracks()
                    .forEach(track => track.stop());

                microphoneStream = null;
            }

            if (inputAudioContext) {
                await inputAudioContext.close();
                inputAudioContext = null;
            }

            if (outputAudioContext) {
                await outputAudioContext.close();
                outputAudioContext = null;
            }

            nextPlaybackTime = 0;
        }


        function resetCallUI() {
            callActive = false;

            callButton.disabled = false;
            callButton.textContent = "Start Call";
            callButton.classList.remove("end-call");

            connectionStatus.textContent = "Ready";

            statusDot.classList.remove(
                "connected",
                "connecting",
                "error"
            );

            messageText.textContent =
                "Press Start Call to speak with " +
                "the support agent.";
        }
    </script>
</body>
</html>




