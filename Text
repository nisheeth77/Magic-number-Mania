<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DU Virtual Support</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', path='/style.css') }}"
    >
</head>

<body>
    <main class="app-container">

        <section class="agent-card">

            <div class="status-row">
                <span class="status-dot"></span>
                <span id="connectionStatus">Ready</span>
            </div>

            <div class="avatar">
                <span>DU</span>
            </div>

            <h1>DU Virtual Support</h1>

            <p class="subtitle">
                Your AI-powered customer support assistant
            </p>

            <div class="conversation">
                <p id="message">
                    Press Start Call to speak with the support agent.
                </p>
            </div>

            <button id="callButton" class="call-button">
                Start Call
            </button>

            <p class="privacy-note">
                Your microphone will only be used during the active call.
            </p>

        </section>

    </main>

    <script>
        const callButton = document.getElementById("callButton");
        const statusText = document.getElementById("connectionStatus");
        const message = document.getElementById("message");

        let callActive = false;

        callButton.addEventListener("click", () => {
            callActive = !callActive;

            if (callActive) {
                callButton.textContent = "End Call";
                callButton.classList.add("end-call");

                statusText.textContent = "Call connected";
                message.textContent =
                    "Voice connection will be added in the next step.";
            } else {
                callButton.textContent = "Start Call";
                callButton.classList.remove("end-call");

                statusText.textContent = "Ready";
                message.textContent =
                    "Press Start Call to speak with the support agent.";
            }
        });
    </script>
</body>
</html>


