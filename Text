import tracing  # Must stay first

import asyncio
from opentelemetry import trace

from agent_framework import WorkflowBuilder
from executors import HRAgent, ITAgent


async def main():
    hr = HRAgent(id="hr")
    it = ITAgent(id="it")

    workflow = (
        WorkflowBuilder(
            start_executor=hr,
            name="HR and IT Workflow",
        )
        .add_edge(hr, it)
        .build()
    )

    result = await workflow.run("Hello from HR")
    print(result)

    # Force pending telemetry to Application Insights
    provider = trace.get_tracer_provider()

    if hasattr(provider, "force_flush"):
        provider.force_flush(timeout_millis=10000)


if __name__ == "__main__":
    asyncio.run(main())


