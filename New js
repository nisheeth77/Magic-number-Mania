"use strict";

/* =========================================================
   DU Voice Avatar
   Browser <-> FastAPI WebSocket <-> Azure Voice Live

   - Microphone input: PCM16 mono, 24 kHz, sent as binary WS data
   - Agent transcript/events: received through /ws/voice
   - Avatar video + primary avatar audio: WebRTC
   - Agent PCM audio: WebSocket fallback when WebRTC audio is absent
   ========================================================= */

const state = {
    config: null,

    voiceSocket: null,
    peerConnection: null,
    avatarDataChannel: null,

    remoteVideoStream: null,
    remoteAudioStream: null,
    remoteAudioTrackActive: false,

    avatarConfigSent: false,
    avatarConnectStarted: false,
    avatarConnected: false,

    microphoneStream: null,
    captureContext: null,
    microphoneSource: null,
    audioProcessor: null,

    playbackContext: null,
    nextPlaybackTime: 0,
    playbackSources: new Set(),
    outputSampleRate: 24000,

    callActive: false,
    callStarting: false,
    callEnding: false,
    microphoneMuted: false,

    callStartedAt: null,
    timerHandle: null,

    currentUserTranscript: "",
    currentAgentTranscript: ""
};


/* =========================================================
   DOM elements
   ========================================================= */

const elements = {
    startButton: document.getElementById("startCallBtn"),
    muteButton: document.getElementById("muteBtn"),
    endButton: document.getElementById("endCallBtn"),

    statusText: document.getElementById("statusText"),
    statusDot: document.getElementById("statusDot"),
    callTimer: document.getElementById("callTimer"),

    avatarVideo: document.getElementById("avatarVideo"),
    avatarAudio: document.getElementById("avatarAudio"),
    avatarPlaceholder: document.getElementById("avatarPlaceholder"),

    listeningIndicator: document.getElementById("listeningIndicator"),
    speakingIndicator: document.getElementById("speakingIndicator"),

    transcriptContainer: document.getElementById("transcriptContainer")
};


/* =========================================================
   Logging and UI helpers
   ========================================================= */

function log(message, value = undefined) {
    const time = new Date().toLocaleTimeString();

    if (value === undefined) {
        console.log(`[${time}] ${message}`);
    } else {
        console.log(`[${time}] ${message}`, value);
    }
}

function errorMessage(error) {
    return error instanceof Error ? error.message : String(error);
}

function setStatus(message, statusClass = "disconnected") {
    if (elements.statusText) {
        elements.statusText.textContent = message;
    }

    if (!elements.statusDot) {
        return;
    }

    elements.statusDot.classList.remove(
        "disconnected",
        "connecting",
        "connected",
        "listening",
        "speaking",
        "error"
    );

    elements.statusDot.classList.add(statusClass);
}

function setAssistantSpeaking(isSpeaking) {
    if (elements.speakingIndicator) {
        elements.speakingIndicator.hidden = !isSpeaking;
    }

    if (isSpeaking) {
        setStatus("Lisa is speaking", "speaking");
    }
}

function setUserListening(isListening) {
    if (elements.listeningIndicator) {
        elements.listeningIndicator.hidden = !isListening;
    }

    if (isListening) {
        setStatus("Listening…", "listening");
    }
}

function updateButtons() {
    if (elements.startButton) {
        elements.startButton.disabled =
            state.callActive || state.callStarting;
    }

    if (elements.muteButton) {
        elements.muteButton.disabled = !state.callActive;
    }

    if (elements.endButton) {
        elements.endButton.disabled =
            !state.callActive && !state.callStarting;
    }
}

function showError(message) {
    console.error(message);
    setStatus(`Error: ${message}`, "error");
}

function getOrCreateAvatarAudioElement() {
    if (elements.avatarAudio) {
        return elements.avatarAudio;
    }

    const audio = document.createElement("audio");
    audio.id = "avatarAudio";
    audio.autoplay = true;
    audio.controls = false;
    audio.style.display = "none";
    document.body.appendChild(audio);
    elements.avatarAudio = audio;

    return audio;
}

async function unlockBrowserAudio() {
    const AudioContextClass =
        window.AudioContext || window.webkitAudioContext;

    if (!AudioContextClass) {
        throw new Error("Web Audio API is not supported by this browser.");
    }

    if (!state.playbackContext) {
        state.playbackContext = new AudioContextClass({
            sampleRate: state.outputSampleRate
        });
        state.nextPlaybackTime = state.playbackContext.currentTime;
    }

    if (state.playbackContext.state === "suspended") {
        await state.playbackContext.resume();
    }

    const avatarAudio = getOrCreateAvatarAudioElement();
    avatarAudio.muted = false;
    avatarAudio.volume = 1;
}


/* =========================================================
   Configuration
   ========================================================= */

async function loadConfiguration() {
    const response = await fetch("/config", {
        method: "GET",
        headers: {
            Accept: "application/json"
        },
        cache: "no-store"
    });

    if (!response.ok) {
        throw new Error(
            `Unable to load /config. HTTP ${response.status}`
        );
    }

    const config = await response.json();

    if (!config.voiceWebSocketUrl) {
        throw new Error(
            "voiceWebSocketUrl is missing from /config."
        );
    }

    return config;
}

function createBrowserWebSocketUrl(path) {
    const protocol =
        window.location.protocol === "https:" ? "wss:" : "ws:";

    return `${protocol}//${window.location.host}${path}`;
}


/* =========================================================
   Call timer
   ========================================================= */

function startCallTimer() {
    stopCallTimer();

    state.callStartedAt = Date.now();
    updateCallTimer();

    state.timerHandle = window.setInterval(
        updateCallTimer,
        1000
    );
}

function updateCallTimer() {
    if (!state.callStartedAt || !elements.callTimer) {
        return;
    }

    const elapsedSeconds = Math.floor(
        (Date.now() - state.callStartedAt) / 1000
    );

    const minutes = Math.floor(elapsedSeconds / 60);
    const seconds = elapsedSeconds % 60;

    elements.callTimer.textContent =
        `${String(minutes).padStart(2, "0")}:` +
        `${String(seconds).padStart(2, "0")}`;
}

function stopCallTimer() {
    if (state.timerHandle !== null) {
        window.clearInterval(state.timerHandle);
        state.timerHandle = null;
    }

    state.callStartedAt = null;

    if (elements.callTimer) {
        elements.callTimer.textContent = "00:00";
    }
}


/* =========================================================
   Transcript UI
   ========================================================= */

function removeWelcomeMessage() {
    const welcome =
        elements.transcriptContainer?.querySelector(
            ".transcript-welcome"
        );

    if (welcome) {
        welcome.remove();
    }
}

function scrollTranscriptToBottom() {
    if (!elements.transcriptContainer) {
        return;
    }

    elements.transcriptContainer.scrollTop =
        elements.transcriptContainer.scrollHeight;
}

function getLiveTranscriptBubble(role) {
    if (!elements.transcriptContainer) {
        return null;
    }

    return elements.transcriptContainer.querySelector(
        `[data-live-role="${role}"]`
    );
}

function createTranscriptBubble(role, text, isLive = false) {
    if (!elements.transcriptContainer || !text) {
        return null;
    }

    removeWelcomeMessage();

    const message = document.createElement("div");
    message.className =
        role === "user"
            ? "transcript-message user-message"
            : "transcript-message agent-message";

    if (isLive) {
        message.dataset.liveRole = role;
    }

    const speaker = document.createElement("div");
    speaker.className = "transcript-speaker";
    speaker.textContent = role === "user" ? "You" : "Lisa";

    const body = document.createElement("div");
    body.className = "transcript-text";
    body.textContent = text;

    message.appendChild(speaker);
    message.appendChild(body);
    elements.transcriptContainer.appendChild(message);

    scrollTranscriptToBottom();
    return message;
}

function updateLiveTranscript(role, text) {
    if (!text) {
        return;
    }

    let bubble = getLiveTranscriptBubble(role);

    if (!bubble) {
        bubble = createTranscriptBubble(role, text, true);
    }

    const body = bubble?.querySelector(".transcript-text");

    if (body) {
        body.textContent = text;
    }

    scrollTranscriptToBottom();
}

function finalizeTranscript(role, text) {
    if (!text) {
        return;
    }

    const bubble = getLiveTranscriptBubble(role);

    if (bubble) {
        const body = bubble.querySelector(".transcript-text");

        if (body) {
            body.textContent = text;
        }

        delete bubble.dataset.liveRole;
    } else {
        createTranscriptBubble(role, text, false);
    }

    scrollTranscriptToBottom();
}


/* =========================================================
   WebSocket helpers
   ========================================================= */

function sendJsonEvent(event) {
    if (
        !state.voiceSocket ||
        state.voiceSocket.readyState !== WebSocket.OPEN
    ) {
        log(`Cannot send ${event.type}; WebSocket is not open.`);
        return false;
    }

    state.voiceSocket.send(JSON.stringify(event));
    log(`Browser -> backend: ${event.type}`);

    return true;
}

function connectVoiceWebSocket() {
    return new Promise((resolve, reject) => {
        const url = createBrowserWebSocketUrl(
            state.config.voiceWebSocketUrl
        );

        log(`Opening Voice WebSocket: ${url}`);

        const socket = new WebSocket(url);
        socket.binaryType = "arraybuffer";
        state.voiceSocket = socket;

        let settled = false;

        const connectionTimeout = window.setTimeout(() => {
            if (settled) {
                return;
            }

            settled = true;
            reject(
                new Error(
                    "Timed out while connecting to the backend."
                )
            );
        }, 20000);

        socket.onopen = () => {
            log("Browser WebSocket opened");
            setStatus(
                "Connecting to Azure Voice Live…",
                "connecting"
            );
        };

        socket.onmessage = (event) => {
            if (typeof event.data !== "string") {
                return;
            }

            let message;

            try {
                message = JSON.parse(event.data);
            } catch {
                console.error(
                    "Invalid JSON received from backend:",
                    event.data
                );
                return;
            }

            log(`Backend -> browser: ${message.type}`);

            if (
                !settled &&
                message.type === "application.connected"
            ) {
                settled = true;
                window.clearTimeout(connectionTimeout);
                resolve();
            }

            Promise.resolve(handleVoiceLiveEvent(message)).catch(
                (error) => {
                    console.error(
                        `Failed to process ${message.type}:`,
                        error
                    );
                    showError(errorMessage(error));
                }
            );
        };

        socket.onerror = () => {
            if (!settled) {
                settled = true;
                window.clearTimeout(connectionTimeout);
                reject(
                    new Error(
                        "Unable to establish the backend WebSocket."
                    )
                );
            }
        };

        socket.onclose = (event) => {
            log(
                `Voice WebSocket closed: ${event.code} ` +
                `${event.reason || ""}`
            );

            if (!settled) {
                settled = true;
                window.clearTimeout(connectionTimeout);
                reject(
                    new Error(
                        "Voice WebSocket closed before connecting."
                    )
                );
            }

            if (
                !state.callEnding &&
                (state.callActive || state.callStarting)
            ) {
                showError("Voice connection was closed.");
                cleanupCallResources(false).catch(console.error);
            }
        };
    });
}


/* =========================================================
   Base64 and SDP helpers
   ========================================================= */

function encodeBase64Utf8(value) {
    const bytes = new TextEncoder().encode(value);
    let binary = "";

    for (const byte of bytes) {
        binary += String.fromCharCode(byte);
    }

    return window.btoa(binary);
}

function decodeBase64Utf8(value) {
    const binary = window.atob(value);
    const bytes = new Uint8Array(binary.length);

    for (let index = 0; index < binary.length; index += 1) {
        bytes[index] = binary.charCodeAt(index);
    }

    return new TextDecoder().decode(bytes);
}

function decodeAvatarServerDescription(serverSdp) {
    if (!serverSdp || typeof serverSdp !== "string") {
        throw new Error("Avatar server SDP is missing.");
    }

    let decodedValue = serverSdp;

    try {
        decodedValue = decodeBase64Utf8(serverSdp);
    } catch {
        // Some clients/proxies can expose raw SDP instead.
    }

    try {
        const parsed = JSON.parse(decodedValue);

        if (parsed?.sdp) {
            return {
                type: parsed.type || "answer",
                sdp: parsed.sdp
            };
        }
    } catch {
        // Not JSON; treat the decoded value as raw SDP.
    }

    return {
        type: "answer",
        sdp: decodedValue
    };
}

function normalizeIceServers(value) {
    if (!Array.isArray(value)) {
        return [];
    }

    return value
        .filter((server) => server && server.urls)
        .map((server) => ({
            urls: server.urls,
            username: server.username || undefined,
            credential: server.credential || undefined
        }));
}

function waitForIceGatheringComplete(
    peerConnection,
    timeoutMilliseconds = 10000
) {
    if (peerConnection.iceGatheringState === "complete") {
        return Promise.resolve();
    }

    return new Promise((resolve) => {
        let finished = false;

        const finish = () => {
            if (finished) {
                return;
            }

            finished = true;
            peerConnection.removeEventListener(
                "icegatheringstatechange",
                onStateChanged
            );
            resolve();
        };

        const onStateChanged = () => {
            log(
                `Avatar ICE gathering: ` +
                peerConnection.iceGatheringState
            );

            if (peerConnection.iceGatheringState === "complete") {
                finish();
            }
        };

        peerConnection.addEventListener(
            "icegatheringstatechange",
            onStateChanged
        );

        window.setTimeout(finish, timeoutMilliseconds);
    });
}


/* =========================================================
   WebRTC avatar
   ========================================================= */

function sendAvatarConfiguration() {
    if (state.avatarConfigSent) {
        return;
    }

    const avatar = state.config?.avatar || {};

    const sent = sendJsonEvent({
        type: "session.update",
        session: {
            modalities: ["text", "audio"],
            avatar: {
                type: "video-avatar",
                character: avatar.character || "lisa",
                style: avatar.style || "casual-sitting",
                customized: avatar.customized ?? false,
                output_protocol: "webrtc",

                // Also provide PCM output on the WS as a safe fallback.
                // It is only played when no WebRTC audio track is active.
                output_audit_audio: true,

                video: {
                    codec: "h264",
                    bitrate: 2000000,
                    resolution: {
                        width: 1280,
                        height: 720
                    }
                }
            }
        }
    });

    if (sent) {
        state.avatarConfigSent = true;
        setStatus("Preparing Lisa’s avatar…", "connecting");
    }
}

async function attachRemoteVideoTrack(event) {
    const stream =
        event.streams?.[0] || new MediaStream([event.track]);

    state.remoteVideoStream = stream;

    if (!elements.avatarVideo) {
        throw new Error("avatarVideo element was not found in HTML.");
    }

    elements.avatarVideo.srcObject = stream;
    elements.avatarVideo.autoplay = true;
    elements.avatarVideo.playsInline = true;
    elements.avatarVideo.muted = true;
    elements.avatarVideo.style.display = "block";

    if (elements.avatarPlaceholder) {
        elements.avatarPlaceholder.hidden = true;
        elements.avatarPlaceholder.style.display = "none";
    }

    try {
        await elements.avatarVideo.play();
        log("Avatar video playback started");
    } catch (error) {
        console.error("Avatar video play failed:", error);
        setStatus(
            "Click once on the page to enable avatar playback",
            "connecting"
        );
    }
}

async function attachRemoteAudioTrack(event) {
    const stream =
        event.streams?.[0] || new MediaStream([event.track]);

    state.remoteAudioStream = stream;
    state.remoteAudioTrackActive = true;

    // Stop fallback PCM audio to avoid duplicate playback.
    clearAgentAudio();

    const avatarAudio = getOrCreateAvatarAudioElement();
    avatarAudio.srcObject = stream;
    avatarAudio.autoplay = true;
    avatarAudio.muted = false;
    avatarAudio.volume = 1;

    event.track.onended = () => {
        state.remoteAudioTrackActive = false;
        log("Avatar WebRTC audio track ended");
    };

    try {
        await avatarAudio.play();
        log("Avatar WebRTC audio playback started");
    } catch (error) {
        console.error("Avatar audio play failed:", error);
        state.remoteAudioTrackActive = false;
        setStatus(
            "Click once on the page to enable sound",
            "connecting"
        );
    }
}

async function createAvatarPeerConnection(iceServers = []) {
    if (state.avatarConnectStarted || state.peerConnection) {
        return;
    }

    state.avatarConnectStarted = true;

    const normalizedIceServers = normalizeIceServers(iceServers);
    log("Avatar ICE servers", normalizedIceServers);

    const peerConnection = new RTCPeerConnection({
        iceServers: normalizedIceServers,
        bundlePolicy: "max-bundle"
    });

    state.peerConnection = peerConnection;

    peerConnection.oniceconnectionstatechange = () => {
        log(
            "Avatar ICE state: " +
            peerConnection.iceConnectionState
        );
    };

    peerConnection.onconnectionstatechange = () => {
        const connectionState = peerConnection.connectionState;
        log(`Avatar connection state: ${connectionState}`);

        if (connectionState === "connected") {
            state.avatarConnected = true;
            setStatus("Connected — you can speak", "connected");
        }

        if (
            (connectionState === "failed" ||
                connectionState === "closed") &&
            !state.callEnding
        ) {
            showError(`Avatar connection ${connectionState}.`);
        }

        if (connectionState === "disconnected") {
            setStatus("Avatar connection interrupted…", "connecting");
        }
    };

    peerConnection.onicecandidateerror = (event) => {
        console.error("Avatar ICE candidate error:", event);
    };

    peerConnection.ontrack = (event) => {
        log(
            `Avatar remote track: ${event.track.kind} ` +
            `${event.track.readyState}`
        );

        if (event.track.kind === "video") {
            attachRemoteVideoTrack(event).catch((error) => {
                showError(errorMessage(error));
            });
        } else if (event.track.kind === "audio") {
            attachRemoteAudioTrack(event).catch((error) => {
                showError(errorMessage(error));
            });
        }
    };

    // Microsoft’s avatar sample requests both media tracks.
    peerConnection.addTransceiver("video", {
        direction: "sendrecv"
    });

    peerConnection.addTransceiver("audio", {
        direction: "sendrecv"
    });

    state.avatarDataChannel =
        peerConnection.createDataChannel("eventChannel");

    state.avatarDataChannel.onmessage = (event) => {
        log("Avatar WebRTC event", event.data);
    };

    state.avatarDataChannel.onclose = () => {
        log("Avatar data channel closed");
    };

    const offer = await peerConnection.createOffer();
    await peerConnection.setLocalDescription(offer);
    await waitForIceGatheringComplete(peerConnection);

    if (!peerConnection.localDescription) {
        throw new Error(
            "Browser failed to create the avatar SDP offer."
        );
    }

    const clientSdp = encodeBase64Utf8(
        JSON.stringify({
            type: peerConnection.localDescription.type,
            sdp: peerConnection.localDescription.sdp
        })
    );

    const sent = sendJsonEvent({
        type: "session.avatar.connect",
        client_sdp: clientSdp
    });

    if (!sent) {
        throw new Error("Failed to send avatar SDP offer.");
    }

    log(
        `Avatar SDP offer sent (${clientSdp.length} base64 characters)`
    );
    setStatus("Connecting Lisa’s media…", "connecting");
}

async function applyAvatarServerSdp(serverSdp) {
    if (!state.peerConnection) {
        throw new Error(
            "Avatar peer connection does not exist."
        );
    }

    const remoteDescription =
        decodeAvatarServerDescription(serverSdp);

    await state.peerConnection.setRemoteDescription(
        remoteDescription
    );

    log("Avatar server SDP applied");
}


/* =========================================================
   WebSocket PCM audio fallback
   ========================================================= */

function base64ToUint8Array(base64Audio) {
    const binary = window.atob(base64Audio);
    const bytes = new Uint8Array(binary.length);

    for (let index = 0; index < binary.length; index += 1) {
        bytes[index] = binary.charCodeAt(index);
    }

    return bytes;
}

function pcm16BytesToFloat32(bytes) {
    // Skip a WAV header if one is present.
    let byteOffset = 0;

    if (
        bytes.length > 44 &&
        String.fromCharCode(...bytes.slice(0, 4)) === "RIFF"
    ) {
        byteOffset = 44;
    }

    const availableBytes = bytes.byteLength - byteOffset;
    const sampleCount = Math.floor(availableBytes / 2);
    const samples = new Float32Array(sampleCount);
    const view = new DataView(
        bytes.buffer,
        bytes.byteOffset + byteOffset,
        sampleCount * 2
    );

    for (let index = 0; index < sampleCount; index += 1) {
        const pcmValue = view.getInt16(index * 2, true);
        samples[index] =
            pcmValue < 0
                ? pcmValue / 0x8000
                : pcmValue / 0x7fff;
    }

    return samples;
}

async function playAgentAudio(base64Audio) {
    if (!base64Audio || state.remoteAudioTrackActive) {
        return;
    }

    await unlockBrowserAudio();

    const bytes = base64ToUint8Array(base64Audio);
    const samples = pcm16BytesToFloat32(bytes);

    if (samples.length === 0) {
        return;
    }

    const audioBuffer = state.playbackContext.createBuffer(
        1,
        samples.length,
        state.outputSampleRate
    );

    audioBuffer.copyToChannel(samples, 0);

    const source = state.playbackContext.createBufferSource();
    source.buffer = audioBuffer;
    source.connect(state.playbackContext.destination);

    const startTime = Math.max(
        state.playbackContext.currentTime + 0.01,
        state.nextPlaybackTime
    );

    source.start(startTime);
    state.nextPlaybackTime = startTime + audioBuffer.duration;
    state.playbackSources.add(source);

    source.onended = () => {
        state.playbackSources.delete(source);
    };
}

function clearAgentAudio() {
    for (const source of state.playbackSources) {
        try {
            source.stop();
        } catch {
            // The source might have already ended.
        }
    }

    state.playbackSources.clear();

    if (state.playbackContext) {
        state.nextPlaybackTime =
            state.playbackContext.currentTime;
    }
}


/* =========================================================
   Microphone capture
   ========================================================= */

function downsampleTo24Khz(inputSamples, inputRate) {
    const outputRate = 24000;

    if (inputRate === outputRate) {
        return new Float32Array(inputSamples);
    }

    const ratio = inputRate / outputRate;
    const outputLength = Math.round(
        inputSamples.length / ratio
    );
    const output = new Float32Array(outputLength);

    let outputIndex = 0;
    let inputIndex = 0;

    while (outputIndex < outputLength) {
        const nextInputIndex = Math.round(
            (outputIndex + 1) * ratio
        );

        let total = 0;
        let count = 0;

        for (
            let index = inputIndex;
            index < nextInputIndex &&
            index < inputSamples.length;
            index += 1
        ) {
            total += inputSamples[index];
            count += 1;
        }

        output[outputIndex] = count > 0 ? total / count : 0;
        outputIndex += 1;
        inputIndex = nextInputIndex;
    }

    return output;
}

function float32ToPcm16(floatSamples) {
    const pcmBuffer = new ArrayBuffer(floatSamples.length * 2);
    const view = new DataView(pcmBuffer);

    for (
        let index = 0;
        index < floatSamples.length;
        index += 1
    ) {
        const sample = Math.max(
            -1,
            Math.min(1, floatSamples[index])
        );

        const pcmValue =
            sample < 0
                ? sample * 0x8000
                : sample * 0x7fff;

        view.setInt16(index * 2, pcmValue, true);
    }

    return pcmBuffer;
}

async function startMicrophoneCapture() {
    if (!navigator.mediaDevices?.getUserMedia) {
        throw new Error(
            "This browser does not support microphone capture."
        );
    }

    state.microphoneStream =
        await navigator.mediaDevices.getUserMedia({
            audio: {
                channelCount: 1,
                sampleRate: 24000,
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true
            },
            video: false
        });

    const AudioContextClass =
        window.AudioContext || window.webkitAudioContext;

    state.captureContext = new AudioContextClass();
    await state.captureContext.resume();

    state.microphoneSource =
        state.captureContext.createMediaStreamSource(
            state.microphoneStream
        );

    // ScriptProcessor is used for a single-file implementation.
    // AudioWorklet can replace it later for production hardening.
    state.audioProcessor =
        state.captureContext.createScriptProcessor(
            4096,
            1,
            1
        );

    state.audioProcessor.onaudioprocess = (event) => {
        if (
            !state.callActive ||
            state.microphoneMuted ||
            !state.voiceSocket ||
            state.voiceSocket.readyState !== WebSocket.OPEN
        ) {
            return;
        }

        const inputSamples =
            event.inputBuffer.getChannelData(0);

        const samples24Khz = downsampleTo24Khz(
            inputSamples,
            state.captureContext.sampleRate
        );

        const pcm16Buffer = float32ToPcm16(samples24Khz);
        state.voiceSocket.send(pcm16Buffer);
    };

    state.microphoneSource.connect(state.audioProcessor);
    state.audioProcessor.connect(
        state.captureContext.destination
    );

    log(
        `Microphone started at ` +
        `${state.captureContext.sampleRate} Hz`
    );
}

function stopMicrophoneCapture() {
    if (state.audioProcessor) {
        state.audioProcessor.onaudioprocess = null;

        try {
            state.audioProcessor.disconnect();
        } catch {
            // Ignore cleanup errors.
        }

        state.audioProcessor = null;
    }

    if (state.microphoneSource) {
        try {
            state.microphoneSource.disconnect();
        } catch {
            // Ignore cleanup errors.
        }

        state.microphoneSource = null;
    }

    if (state.microphoneStream) {
        state.microphoneStream
            .getTracks()
            .forEach((track) => track.stop());

        state.microphoneStream = null;
    }

    if (state.captureContext) {
        state.captureContext.close().catch(() => {});
        state.captureContext = null;
    }
}


/* =========================================================
   Voice Live event processing
   ========================================================= */

function readOutputSampleRate(session) {
    const value =
        session?.output_audio_sampling_rate ||
        session?.outputAudioSamplingRate ||
        session?.output_audio_format?.sample_rate ||
        session?.outputAudioFormat?.sampleRate;

    if (Number.isFinite(Number(value))) {
        state.outputSampleRate = Number(value);
    }
}

function readAvatarIceServers(message) {
    const avatar = message?.session?.avatar;

    return (
        avatar?.ice_servers ||
        avatar?.iceServers ||
        []
    );
}

async function handleVoiceLiveEvent(message) {
    if (!message?.type) {
        return;
    }

    switch (message.type) {
        case "application.connecting":
            setStatus(
                message.message ||
                "Connecting to Azure Voice Live…",
                "connecting"
            );
            break;

        case "application.connected":
            setStatus("Connected to Voice Live", "connecting");
            break;

        case "application.error":
            showError(
                message.message ||
                "The backend reported an error."
            );
            break;

        case "session.created":
            log("Voice Live session created", message.session);
            readOutputSampleRate(message.session);
            sendAvatarConfiguration();
            break;

        case "session.updated": {
            log("Voice Live session updated", message.session);
            readOutputSampleRate(message.session);

            const avatar = message.session?.avatar;

            if (
                state.avatarConfigSent &&
                avatar &&
                !state.avatarConnectStarted
            ) {
                const iceServers = readAvatarIceServers(message);
                await createAvatarPeerConnection(iceServers);
            }
            break;
        }

        case "session.avatar.connecting":
            setStatus("Applying Lisa’s media connection…", "connecting");
            await applyAvatarServerSdp(
                message.server_sdp || message.serverSdp
            );
            break;

        case "session.avatar.connected":
            state.avatarConnected = true;
            setStatus("Connected — you can speak", "connected");
            break;

        case "session.avatar.switch_to_speaking":
            setUserListening(false);
            setAssistantSpeaking(true);
            break;

        case "session.avatar.switch_to_idle":
            setAssistantSpeaking(false);

            if (state.callActive) {
                setStatus("Connected — you can speak", "connected");
            }
            break;

        case "session.avatar.disconnected":
            state.avatarConnected = false;
            state.remoteAudioTrackActive = false;
            setStatus("Avatar disconnected", "error");
            break;

        case "input_audio_buffer.speech_started":
            state.currentUserTranscript = "";

            // Barge-in: stop queued fallback audio immediately.
            clearAgentAudio();

            sendJsonEvent({
                type: "output_audio_buffer.clear"
            });

            setAssistantSpeaking(false);
            setUserListening(true);
            break;

        case "input_audio_buffer.speech_stopped":
            setUserListening(false);
            setStatus("Processing your request…", "connecting");
            break;

        case "conversation.item.input_audio_transcription.delta":
            state.currentUserTranscript += message.delta || "";
            updateLiveTranscript(
                "user",
                state.currentUserTranscript
            );
            break;

        case "conversation.item.input_audio_transcription.completed":
            state.currentUserTranscript =
                message.transcript ||
                state.currentUserTranscript;

            finalizeTranscript(
                "user",
                state.currentUserTranscript
            );

            state.currentUserTranscript = "";
            break;

        case "response.created":
            state.currentAgentTranscript = "";
            setStatus(
                "Lisa is preparing a response…",
                "connecting"
            );
            break;

        case "response.audio.delta":
            // WebRTC audio is primary. PCM is fallback/audit audio.
            await playAgentAudio(message.delta);
            setAssistantSpeaking(true);
            break;

        case "response.audio_transcript.delta":
            state.currentAgentTranscript += message.delta || "";
            updateLiveTranscript(
                "assistant",
                state.currentAgentTranscript
            );
            break;

        case "response.audio_transcript.done":
            state.currentAgentTranscript =
                message.transcript ||
                state.currentAgentTranscript;

            finalizeTranscript(
                "assistant",
                state.currentAgentTranscript
            );

            state.currentAgentTranscript = "";
            break;

        case "response.text.delta":
            state.currentAgentTranscript += message.delta || "";
            updateLiveTranscript(
                "assistant",
                state.currentAgentTranscript
            );
            break;

        case "response.text.done":
            state.currentAgentTranscript =
                message.text || state.currentAgentTranscript;

            finalizeTranscript(
                "assistant",
                state.currentAgentTranscript
            );

            state.currentAgentTranscript = "";
            break;

        case "response.audio.done":
            if (!state.avatarConnected) {
                setAssistantSpeaking(false);
                setStatus("Connected — you can speak", "connected");
            }
            break;

        case "response.done":
            if (!state.remoteAudioTrackActive) {
                setAssistantSpeaking(false);
            }

            if (state.callActive) {
                setStatus("Connected — you can speak", "connected");
            }
            break;

        case "warning":
            console.warn(
                "Voice Live warning:",
                message.warning || message
            );
            break;

        case "error":
            console.error("Azure Voice Live error:", message);
            showError(
                message.error?.message ||
                message.message ||
                "Azure Voice Live returned an error."
            );
            break;

        default:
            log(`Unhandled event: ${message.type}`);
            break;
    }
}


/* =========================================================
   Call controls
   ========================================================= */

async function startCall() {
    if (state.callActive || state.callStarting) {
        return;
    }

    state.callStarting = true;
    state.callEnding = false;
    updateButtons();

    try {
        setStatus("Preparing call…", "connecting");

        if (!state.config) {
            state.config = await loadConfiguration();
        }

        // Start/resume audio from the user gesture before async media arrives.
        await unlockBrowserAudio();
        await connectVoiceWebSocket();

        state.callActive = true;
        state.callStarting = false;

        startCallTimer();
        updateButtons();

        await startMicrophoneCapture();

        setStatus(
            "Connected — preparing Lisa…",
            "connecting"
        );
    } catch (error) {
        state.callStarting = false;
        showError(errorMessage(error));
        await endCall(false);
    }
}

function toggleMute() {
    if (!state.callActive) {
        return;
    }

    state.microphoneMuted = !state.microphoneMuted;

    if (state.microphoneStream) {
        state.microphoneStream
            .getAudioTracks()
            .forEach((track) => {
                track.enabled = !state.microphoneMuted;
            });
    }

    if (elements.muteButton) {
        elements.muteButton.classList.toggle(
            "muted",
            state.microphoneMuted
        );

        const label =
            elements.muteButton.querySelector(".button-label");

        if (label) {
            label.textContent =
                state.microphoneMuted ? "Unmute" : "Mute";
        }
    }

    setStatus(
        state.microphoneMuted
            ? "Microphone muted"
            : "Connected — you can speak",
        state.microphoneMuted
            ? "disconnected"
            : "connected"
    );
}

async function cleanupCallResources(updateUi = true) {
    stopCallTimer();
    stopMicrophoneCapture();
    clearAgentAudio();

    setUserListening(false);
    setAssistantSpeaking(false);

    if (state.avatarDataChannel) {
        try {
            state.avatarDataChannel.close();
        } catch {
            // Ignore cleanup errors.
        }
        state.avatarDataChannel = null;
    }

    if (state.peerConnection) {
        state.peerConnection.ontrack = null;

        try {
            state.peerConnection.close();
        } catch {
            // Ignore cleanup errors.
        }

        state.peerConnection = null;
    }

    for (const stream of [
        state.remoteVideoStream,
        state.remoteAudioStream
    ]) {
        stream?.getTracks().forEach((track) => track.stop());
    }

    state.remoteVideoStream = null;
    state.remoteAudioStream = null;
    state.remoteAudioTrackActive = false;

    if (elements.avatarVideo) {
        elements.avatarVideo.pause();
        elements.avatarVideo.srcObject = null;
    }

    const avatarAudio = getOrCreateAvatarAudioElement();
    avatarAudio.pause();
    avatarAudio.srcObject = null;

    if (elements.avatarPlaceholder) {
        elements.avatarPlaceholder.hidden = false;
        elements.avatarPlaceholder.style.display = "flex";
    }

    if (state.playbackContext) {
        await state.playbackContext.close().catch(() => {});
        state.playbackContext = null;
        state.nextPlaybackTime = 0;
    }

    state.avatarConfigSent = false;
    state.avatarConnectStarted = false;
    state.avatarConnected = false;
    state.microphoneMuted = false;

    if (elements.muteButton) {
        elements.muteButton.classList.remove("muted");

        const label =
            elements.muteButton.querySelector(".button-label");

        if (label) {
            label.textContent = "Mute";
        }
    }

    if (updateUi) {
        setStatus("Call ended", "disconnected");
    }

    updateButtons();
}

async function endCall(updateUi = true) {
    if (state.callEnding) {
        return;
    }

    state.callEnding = true;
    state.callActive = false;
    state.callStarting = false;

    if (
        state.voiceSocket &&
        state.voiceSocket.readyState === WebSocket.OPEN
    ) {
        try {
            state.voiceSocket.send(
                JSON.stringify({
                    type: "application.disconnect"
                })
            );
            state.voiceSocket.close(1000, "Call ended by user");
        } catch {
            // Ignore cleanup errors.
        }
    }

    state.voiceSocket = null;

    await cleanupCallResources(updateUi);

    state.callEnding = false;
    log("Call resources cleaned up");
}


/* =========================================================
   Initialization
   ========================================================= */

async function initializeApplication() {
    setStatus("Ready to start", "disconnected");
    stopCallTimer();
    updateButtons();
    getOrCreateAvatarAudioElement();

    try {
        state.config = await loadConfiguration();
        log("Frontend configuration loaded", state.config);
    } catch (error) {
        showError(errorMessage(error));
    }

    elements.startButton?.addEventListener("click", startCall);
    elements.muteButton?.addEventListener("click", toggleMute);
    elements.endButton?.addEventListener(
        "click",
        () => endCall(true)
    );

    // Browsers can block autoplay. A later click resumes media safely.
    document.addEventListener(
        "click",
        () => {
            unlockBrowserAudio().catch(() => {});

            const avatarAudio = getOrCreateAvatarAudioElement();
            if (avatarAudio.srcObject && avatarAudio.paused) {
                avatarAudio.play().catch(() => {});
            }

            if (
                elements.avatarVideo?.srcObject &&
                elements.avatarVideo.paused
            ) {
                elements.avatarVideo.play().catch(() => {});
            }
        },
        { passive: true }
    );

    window.addEventListener("beforeunload", () => {
        stopMicrophoneCapture();
        clearAgentAudio();

        if (state.peerConnection) {
            state.peerConnection.close();
        }

        if (state.voiceSocket) {
            state.voiceSocket.close();
        }
    });
}

document.addEventListener(
    "DOMContentLoaded",
    initializeApplication
);

 
